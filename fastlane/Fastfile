# Fastlane: Natalo Petshop iOS automation
# Dijalankan di GitHub Actions runner macos-15.
# Kamu (di Windows) tidak perlu install fastlane lokal.

default_platform(:ios)

TEAM_ID = "87FXPV558A" # Apple Developer team ID Leonardi Agustinus
APP_BUNDLE = "com.natalo.petshop"
PROFILE_NAME = "match AppStore com.natalo.petshop"
XCODEPROJ = "ios/App/App.xcodeproj"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
    # setup_ci default-nya MATCH_READONLY=true. Override karena kita butuh
    # match generate cert/profile pertama kali (repo natalo-ios-certs masih kosong).
    # Setelah cert ada, run berikutnya bisa readonly aman.
    ENV["MATCH_READONLY"] = "false"
  end

  desc "Build .ipa + upload ke TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false,
      in_house: false,
    )

    # Sync App Store distribution cert + provisioning profile via match.
    # First run: match akan auto-generate cert & profile, simpan encrypted ke MATCH_GIT_URL.
    match(
      type: "appstore",
      readonly: false, # Allow first-time creation
      api_key: api_key,
      app_identifier: "com.natalo.petshop",
    )

    # Auto-bump marketing version saat version current sudah ter-release ke
    # App Store. Apple lock version yang sudah public — build baru harus
    # pakai marketing version lebih tinggi.
    #
    # Capacitor template pakai $(MARKETING_VERSION) build setting variable di
    # Info.plist, bukan literal. Fastlane's increment_version_number tidak
    # bisa parse build setting — pakai agvtool langsung (Apple official tool
    # yang resolve build setting dengan benar).
    #
    # Read current resolved version dari Info.plist (agvtool what-marketing-version
    # bisa fail kalau MARKETING_VERSION setting baru, jadi pakai PlistBuddy
    # fallback ke literal value yang sudah ter-resolve).
    current_version_raw = sh("cd ios/App && agvtool what-marketing-version -terse1 2>/dev/null || echo unknown").strip
    UI.message("Current marketing version (agvtool): #{current_version_raw}")

    begin
      latest_app_store_version = google_app_store_build_number = app_store_build_number(
        api_key: api_key,
        app_identifier: APP_BUNDLE,
        live: true,
      )
      live_version = lane_context[SharedValues::LATEST_VERSION]
      UI.message("Latest live App Store: version=#{live_version} build=#{latest_app_store_version}")
    rescue => e
      UI.important("Tidak bisa fetch live App Store version: #{e.message}")
      latest_app_store_version = nil
      live_version = nil
    end

    # Strategi: kalau ada version live di App Store, bump current ke patch+1
    # dari live version. Mis. live=1.0 → next=1.0.1.
    if live_version && !live_version.empty?
      parts = live_version.split(".").map(&:to_i)
      parts << 0 while parts.length < 3
      parts[2] += 1
      new_version = parts.join(".")
      UI.message("Bumping marketing version: #{live_version} → #{new_version}")
      sh("cd ios/App && agvtool new-marketing-version #{new_version}")
    else
      UI.message("Skip version bump — no live App Store version detected.")
    end

    # Auto-increment build number berdasarkan TestFlight terakhir + 1.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.natalo.petshop",
      initial_build_number: 0,
    ) + 1

    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: build_number,
    )

    # Capacitor template tidak set DEVELOPMENT_TEAM di project.pbxproj.
    # Force manual signing dengan team + profile dari match — biar archive
    # tahu cert/profile mana yang dipakai (tanpa modifikasi pbxproj).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: TEAM_ID,
      bundle_identifier: APP_BUNDLE,
      profile_name: PROFILE_NAME,
      code_sign_identity: "Apple Distribution",
      targets: ["App"],
      build_configurations: ["Release"],
    )

    # Build & sign .ipa
    build_app(
      project: ENV["GYM_PROJECT"] || XCODEPROJ,
      scheme: ENV["GYM_SCHEME"] || "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Natalo-Petshop.ipa",
      clean: true,
      include_bitcode: false,
      include_symbols: true,
      xcargs: "DEVELOPMENT_TEAM=#{TEAM_ID} CODE_SIGN_STYLE=Manual",
      export_options: {
        provisioningProfiles: {
          APP_BUNDLE => PROFILE_NAME,
        },
        teamID: TEAM_ID,
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
      },
    )

    # Upload ke TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/Natalo-Petshop.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true, # Internal testers only, no review needed
    )

    UI.success("✅ Build #{build_number} ke TestFlight beres. Cek email TestFlight di iPhone.")
  end

  desc "Build .ipa saja, tanpa upload (output sebagai artifact GitHub)"
  lane :build_only do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false,
    )

    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      app_identifier: "com.natalo.petshop",
    )

    build_app(
      project: ENV["GYM_PROJECT"] || "ios/App/App.xcodeproj",
      scheme: ENV["GYM_SCHEME"] || "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Natalo-Petshop.ipa",
      clean: true,
    )

    UI.success("✅ .ipa selesai di ./build/Natalo-Petshop.ipa")
  end

  desc "Nuke + regenerate App Store distribution cert + profile"
  desc "Pakai saat profile di Apple Developer Console berstatus 'Invalid'"
  desc "atau setelah enable capability baru (mis. Push Notifications) yg tidak terbawa ke profile lama."
  lane :regenerate_distribution do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false,
      in_house: false,
    )

    UI.message("🧹 Nuke existing App Store distribution cert + profile (Apple + match repo)...")

    # match_nuke hapus distribution cert + profile dari:
    # - Apple Developer Portal
    # - Match encrypted git repo (natalo-ios-certs)
    # Setelah nuke, harus regenerate fresh — itulah call match() di bawah.
    # skip_confirmation auto-yes untuk CI environment.
    begin
      match_nuke(
        type: "appstore",
        team_id: TEAM_ID,
        api_key: api_key,
        skip_confirmation: true,
      )
    rescue => e
      UI.important("Nuke gagal (mungkin nothing to nuke): #{e.message} — lanjut regenerate.")
    end

    UI.message("🔑 Generate fresh App Store distribution cert + profile...")

    # match dengan readonly: false + force: true akan create cert + profile baru
    # yang otomatis include semua capabilities yang sekarang ada di App ID
    # (Associated Domains, In-App Purchase, Push Notifications).
    match(
      type: "appstore",
      readonly: false,
      force: true,
      api_key: api_key,
      app_identifier: APP_BUNDLE,
    )

    UI.success("✅ Distribution profile baru sudah valid + include Push Notifications.")
    UI.success("   Sekarang run lane 'beta' untuk build + upload ke TestFlight.")
  end

  error do |lane, exception|
    UI.error("❌ Lane #{lane} gagal: #{exception.message}")
  end
end
