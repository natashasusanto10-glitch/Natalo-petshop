# Fastlane: Natalo Petshop iOS automation
# Dijalankan di GitHub Actions runner macos-15.
# Kamu (di Windows) tidak perlu install fastlane lokal.

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build .ipa + upload ke TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false,
      in_house: false,
    )

    # Sync App Store distribution cert + provisioning profile via match.
    # First run: match akan auto-generate cert & profile, simpan encrypted ke MATCH_GIT_URL.
    match(
      type: "appstore",
      readonly: false, # Allow first-time creation
      api_key: api_key,
      app_identifier: "com.natalo.petshop",
    )

    # Auto-increment build number berdasarkan TestFlight terakhir + 1.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.natalo.petshop",
      initial_build_number: 0,
    ) + 1

    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: build_number,
    )

    # Build & sign .ipa
    build_app(
      workspace: ENV["GYM_WORKSPACE"] || "ios/App/App.xcworkspace",
      scheme: ENV["GYM_SCHEME"] || "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Natalo-Petshop.ipa",
      clean: true,
      include_bitcode: false,
      include_symbols: true,
      export_options: {
        provisioningProfiles: {
          "com.natalo.petshop" => "match AppStore com.natalo.petshop",
        },
      },
    )

    # Upload ke TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/Natalo-Petshop.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true, # Internal testers only, no review needed
    )

    UI.success("✅ Build #{build_number} ke TestFlight beres. Cek email TestFlight di iPhone.")
  end

  desc "Build .ipa saja, tanpa upload (output sebagai artifact GitHub)"
  lane :build_only do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false,
    )

    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      app_identifier: "com.natalo.petshop",
    )

    build_app(
      workspace: ENV["GYM_WORKSPACE"] || "ios/App/App.xcworkspace",
      scheme: ENV["GYM_SCHEME"] || "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Natalo-Petshop.ipa",
      clean: true,
    )

    UI.success("✅ .ipa selesai di ./build/Natalo-Petshop.ipa")
  end

  error do |lane, exception|
    UI.error("❌ Lane #{lane} gagal: #{exception.message}")
  end
end
