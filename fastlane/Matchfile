# Fastlane match — config storage cert/profile encrypted di private git repo
# git_url & username dibaca dari env vars (di-set lewat GitHub Secrets):
#   - MATCH_GIT_URL                  (mis. https://github.com/USERNAME/natalo-ios-certs.git)
#   - MATCH_GIT_BASIC_AUTHORIZATION  (PAT GitHub yang base64-encoded)
#   - MATCH_PASSWORD                 (password enkripsi yang kamu pilih sendiri)

git_url(ENV["MATCH_GIT_URL"]) if ENV["MATCH_GIT_URL"]

storage_mode("git")
type("appstore") # default; override per-lane di Fastfile

app_identifier(["com.natalo.petshop"])

# Branch di repo certs (default master). Bikin private repo kosong dulu.
git_branch("main")
