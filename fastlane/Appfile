# Fastlane Appfile — bundle ID & Apple ID
# apple_id (email) tidak wajib karena pakai App Store Connect API key,
# tapi kalau mau tambah action manual yang butuh login, bisa di-set via env.

app_identifier("com.natalo.petshop")
apple_id(ENV["FASTLANE_USER"]) if ENV["FASTLANE_USER"]

# Team ID otomatis di-fetch dari API key, jadi tidak perlu hard-code.
# Kalau perlu override:
# itc_team_id("XXXXXXXX")  # App Store Connect team ID
# team_id("XXXXXXXXXX")    # Apple Developer Portal team ID
