{
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/**/*.js": {
      "maxDuration": 30
    },
    "app/api/cron/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/feed-reconcile-videos",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/feed-storage-gc",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/abandoned-cart",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/voucher-abuse-detect",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/birthday-voucher",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/auto-confirm-delivered",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/order-confirm-reminder",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/birthday-reminder",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/birthday-voucher-reminder",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/auto-cancel-unpaid-manual",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/loyalty-points-reminder",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/product-video-gc",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/cron/chat-order-outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/promo-notify",
      "schedule": "0 * * * *"
    }
  ]
}
