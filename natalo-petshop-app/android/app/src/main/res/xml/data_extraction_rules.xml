<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data extraction rules.
  cloud-backup: data yg dibackup ke Google Drive (auto backup)
  device-transfer: data yg di-transfer saat switch device (Quick Setup)

  Kita exclude semua karena ini hybrid WebView app — semua state (cookie,
  cart, voucher selection) di-handle oleh WebView via cookies & localStorage
  yang sudah di-backup oleh Chromium WebView engine secara terpisah.
  Backup app-level akan duplicate atau corrupt state.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
