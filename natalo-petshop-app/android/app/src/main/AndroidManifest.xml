<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links — autoVerify=true butuh
                 https://www.natalopetshop.com/.well-known/assetlinks.json
                 berisi SHA-256 fingerprint dari release keystore.
                 Tanpa assetlinks.json yg valid, link tetap buka di app
                 tapi via "Open with..." picker, bukan langsung. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Product URLs, including shared product detail links. -->
                <data android:scheme="https" android:host="www.natalopetshop.com" android:path="/products" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:pathPrefix="/products/" />
                <data android:scheme="https" android:host="natalopetshop.com" android:path="/products" />
                <data android:scheme="https" android:host="natalopetshop.com" android:pathPrefix="/products/" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:path="/produk" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:pathPrefix="/produk/" />
                <data android:scheme="https" android:host="natalopetshop.com" android:path="/produk" />
                <data android:scheme="https" android:host="natalopetshop.com" android:pathPrefix="/produk/" />

                <!-- Other customer-facing URLs that should stay inside the app. -->
                <data android:scheme="https" android:host="www.natalopetshop.com" android:path="/" />
                <data android:scheme="https" android:host="natalopetshop.com" android:path="/" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:path="/cart" />
                <data android:scheme="https" android:host="natalopetshop.com" android:path="/cart" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:path="/wishlist" />
                <data android:scheme="https" android:host="natalopetshop.com" android:path="/wishlist" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:path="/order-status" />
                <data android:scheme="https" android:host="natalopetshop.com" android:path="/order-status" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:pathPrefix="/pesanan/" />
                <data android:scheme="https" android:host="natalopetshop.com" android:pathPrefix="/pesanan/" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:pathPrefix="/kategori/" />
                <data android:scheme="https" android:host="natalopetshop.com" android:pathPrefix="/kategori/" />
                <data android:scheme="https" android:host="www.natalopetshop.com" android:pathPrefix="/member/" />
                <data android:scheme="https" android:host="natalopetshop.com" android:pathPrefix="/member/" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Kamera + galeri untuk @capacitor/camera (review foto, dll).
         CAMERA: ambil foto langsung. READ_MEDIA_IMAGES: pilih dari galeri
         di Android 13+ (API 33). READ_EXTERNAL_STORAGE: galeri di Android 12-
         (maxSdkVersion 32 supaya tidak diminta lagi di Android 13+). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- required=false supaya app tetap installable di device tanpa kamera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Queries: external app intents -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.instagram.android" />
    </queries>
</manifest>
