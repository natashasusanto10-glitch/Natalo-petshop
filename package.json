{
  "name": "toko-pwa-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "dotenv -e .env.local -- prisma migrate deploy",
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "prisma:migrate:status": "dotenv -e .env.local -- prisma migrate status",
    "prisma:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "cap:add:ios": "npx cap add ios",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "cap:assets": "npx capacitor-assets generate --ios --iconBackgroundColor \"#1E5FBF\" --splashBackgroundColor \"#1E5FBF\"",
    "gen:splash": "node scripts/generate-ios-splash.mjs",
    "gen:cap-splash": "node scripts/generate-capacitor-splash.mjs"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/client": "6.19.0",
    "@react-google-maps/api": "^2.20.8",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "meilisearch": "^0.58.0",
    "next": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.12.3",
    "uploadthing": "^7.7.4",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "prisma": {
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.3",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^7.4.4",
    "prisma": "6.19.0",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
