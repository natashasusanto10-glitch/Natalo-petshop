node_modules
.worktrees/
.next
.env
.env*.local
coverage
.DS_Store

# user uploads (jangan masuk repo)
public/uploads/*
!public/uploads/.gitkeep

# Meilisearch local
meilisearch.exe
data.ms/

# Local tunneling tools
ngrok.exe

# Loose AI-generated images / scratch files
ChatGPT Image*.png
splash-preview.png

# Dev server logs
.next-dev.err.log
.next-dev.out.log

# TypeScript build cache
tsconfig.tsbuildinfo

# Folder structure dump (scratch / debugging — heavy text file, don't commit)
struktur-folder.txt

# App Store screenshots are large artifacts — generated via npm run gen:appstore-screenshots
# Komment-out kalau mau commit ke repo (untuk versioning per release):
# screenshots/

# Capacitor iOS build artifacts (everything except hand-edited project files)
ios/App/Pods/
ios/App/Podfile.lock
ios/App/build/
ios/App/App/public/
ios/App/DerivedData/
ios/.build/
ios/*.xcworkspace/xcuserdata/
ios/**/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/

# Capacitor Android scaffold di repo root — regen via `npx cap add android`
# / `cap sync android`. Slash di depan = anchor ke root saja, JANGAN match
# `natalo-petshop-app/android/` (yg punya hand-edited MainActivity, manifest,
# offline.html, dll → tracked terpisah untuk Play Store v1.0.7).
/android/

# Generic Android / Gradle build outputs (untuk natalo-petshop-app/android/).
# Pakai **/ supaya match di sub-tree manapun (gradle build numpuk MB-an).
**/android/app/build/
**/android/build/
**/android/.gradle/
**/android/local.properties
**/android/.idea/
**/android/captures/
**/android/app/release/
**/android/app/debug/
**/android/key.properties
**/android/keystore.properties

# Signing keys & build outputs — sensitive / heavy, never commit.
*.keystore
*.jks
*.aab
*.apk

# Firebase service-account / API config — sensitive, jangan masuk repo.
# Tiap dev/CI generate sendiri dari Firebase Console.
**/google-services.json
**/GoogleService-Info.plist
**/firebase-adminsdk-*.json

# EXCEPTION — Flutter app firebase client config HARUS committed supaya
# Codemagic build resolve them. Files berisi client API keys yang per
# Firebase docs designed to be public (server secrets ada di env vars
# Vercel, bukan di file ini). Tanpa commit → Xcode build fail dengan
# "Build input file cannot be found: GoogleService-Info.plist".
!flutter_app/android/app/google-services.json
!flutter_app/ios/Runner/GoogleService-Info.plist

# Capacitor generated assets (regen via `npm run cap:assets`)
# Note: ios/App/App/Assets.xcassets is committed; only DerivedData ignored.

# Fastlane build outputs
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
*.ipa
*.dSYM.zip
*.dSYM
build/

# Bundler / Ruby
.bundle/
vendor/bundle/

.vercel

# Random local xlsx (data imports, exports)
*.xlsx

# Flutter SDK download (jangan commit, ~3GB)
/flutter/


# Bunny migration runtime artifacts (output dari scripts/migrate-bunny-to-sg.mjs)
scripts/.bunny-migration-*

# ── Credential & secret files — JANGAN PERNAH commit ──
# Apple Push Notification Service (APNs) auth key — credential rahasia
# untuk dispatch push notif iOS. Kalau leak ke git, attacker bisa fake
# push notif ke semua user Natalo + Apple bisa revoke credential.
# Simpan di Vercel env vars (APNS_AUTH_KEY_P8) atau secret manager.
*.p8
AuthKey_*.p8

# Service account / API key files yang sering keluar dari Firebase
# Console / Google Cloud download. Belum di-track sekarang tapi
# defensive supaya gak ke-commit accidentally.
*.serviceaccount.json
google-services-account*.json
firebase-adminsdk-*.json

# Generic credential patterns — keystore, p12 cert, private keys.
*.keystore
*.jks
*.p12
*.pem
!**/lib/**/*.pem
*.key
!**/lib/**/*.key
id_rsa
id_rsa.*
