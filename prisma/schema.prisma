generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  MIDTRANS
  XENDIT
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum VoucherSourceType {
  // Voucher publik admin promo + voucher claim user (BDAY, POIN). Tampil
  // di daftar voucher pembeli. Maks 1 per checkout.
  CUSTOMER
  // Voucher rahasia dari penjual. TIDAK muncul di daftar publik. Hanya
  // bisa di-apply via input kode manual. Maks 1 per checkout.
  SELLER_MANUAL
}

model User {
  id                  String          @id @default(cuid())
  name                String
  phone               String?         @unique
  email               String?         @unique
  passwordHash        String?
  role                String          @default("CUSTOMER")
  tokenVersion        Int             @default(0)
  birthDate           DateTime?
  birthdayVoucherYear Int?
  orders              Order[]
  points              CustomerPoint[]
  reviews             Review[]
  reviewReplies       ReviewReply[]   @relation("AdminReplies")
  reviewVotes         ReviewVote[]    @relation("ReviewVotes")
  addresses           Address[]
  favorites           Favorite[]
  pets                Pet[]
  chatThreads         ChatThread[]     @relation("CustomerChatThreads")
  chatMessages        ChatMessage[]    @relation("ChatSender")
  cartItems           CartItem[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model CartItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String?
  variantLabel String?
  name         String
  price        Int
  quantity     Int
  weightGram   Int      @default(500)
  imageUrl     String?
  stock        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  description       String
  price             Int
  memberPrice       Int?
  discountPrice     Int?
  stock             Int                @default(0)
  weightGram        Int                @default(500)
  imageUrl          String?
  // Galeri tambahan (max 4 gambar). imageUrl tetap jadi thumbnail utama,
  // gallery dipakai di halaman detail produk untuk carousel.
  gallery           String[]           @default([])
  isActive          Boolean            @default(true)
  hasVariants       Boolean            @default(false)
  brandAutoAssigned Boolean            @default(false)
  avgRating         Float              @default(0)
  reviewCount       Int                @default(0)
  ratingBreakdown   Json?
  categoryId        String?
  category          Category?          @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?             @relation(fields: [brandId], references: [id])
  orderItems        OrderItem[]
  reviews           Review[]
  variants          ProductVariant[]
  variantAttrs      VariantAttribute[]
  favorites         Favorite[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Order {
  id                  String          @id @default(cuid())
  orderNumber          String          @unique
  userId               String?
  user                 User?           @relation(fields: [userId], references: [id])
  customerName         String
  customerPhone        String
  customerEmail        String?
  shippingAddress      String
  shippingCity         String?
  shippingPostalCode   String?
  shippingLatitude     Float?
  shippingLongitude    Float?
  shippingPinpointAddress String?
  courierCode          String?
  courierService       String?
  trackingNumber       String?
  trackingToken        String?         @unique
  biteshipOrderId      String?
  biteshipTrackingUrl  String?
  shipmentStatus       String?
  biteshipRequest      Json?
  biteshipResponse     Json?
  biteshipError        String?
  subtotal             Int
  shippingCost         Int             @default(0)
  discount             Int             @default(0)
  total                Int
  status               OrderStatus     @default(PENDING)
  paymentProvider      PaymentProvider @default(MANUAL)
  paymentStatus        PaymentStatus   @default(UNPAID)
  paymentReference     String?
  paymentUrl           String?
  paymentProofUrl      String?
  manualBank           String?
  uniqueCode           Int?
  voucherCode          String? // Customer voucher (CUSTOMER source type)
  manualVoucherCode    String? // Seller manual voucher (SELLER_MANUAL)
  notes                String?
  items                OrderItem[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([biteshipOrderId])
  @@index([shipmentStatus])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  variantLabel String? // snapshot: "4KG / Beef" — tidak berubah meski variant diedit
  name         String
  price        Int
  quantity     Int
  weightGram   Int             @default(500)
  reviews      Review[] // multiple kalau user soft-delete & resubmit
}

model Voucher {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountPercent Int?
  discountAmount  Int?
  minimumOrder    Int       @default(0)
  maxUsage        Int?
  usedCount       Int       @default(0)
  startsAt        DateTime  @default(now())
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  // Voucher milik user spesifik (BDAY, POIN claim). NULL = voucher publik (admin promo).
  userId          String?
  // Source type: CUSTOMER (visible di daftar pembeli) vs SELLER_MANUAL
  // (tersembunyi, hanya via input kode manual). Default CUSTOMER untuk
  // backward compat semua voucher existing.
  sourceType      VoucherSourceType @default(CUSTOMER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  createdAt DateTime @default(now())
}

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation("CustomerChatThreads", fields: [userId], references: [id], onDelete: Cascade)
  status    String        @default("OPEN")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User       @relation("ChatSender", fields: [senderId], references: [id])
  senderRole String
  content    String
  readAt     DateTime?
  createdAt  DateTime   @default(now())

  @@index([threadId, createdAt])
  @@index([senderRole, readAt])
}

model CustomerPoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  source    String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?            // null = belum dipakai
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RegistrationOtp {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String
  passwordHash String
  channel      String
  otpHash      String
  expiresAt    DateTime
  attempts     Int       @default(0)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

enum ReviewStatus {
  VISIBLE
  HIDDEN // di-hide oleh admin
  DELETED // soft-delete oleh user (boleh resubmit)
}

model Review {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String? // referensi varian (null untuk produk non-varian)
  variantLabel String? // snapshot teks dari OrderItem
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  orderItemId  String // 1 review aktif per order_item — diatur di service layer (bukan @unique karena boleh resubmit)
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  rating       Int // 1–5
  title        String?
  content      String?
  status       ReviewStatus  @default(VISIBLE)
  hiddenReason String?
  helpfulCount Int           @default(0)
  images       ReviewImage[]
  reply        ReviewReply?
  votes        ReviewVote[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId, status, createdAt])
  @@index([userId])
  @@index([orderItemId])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl  String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ReviewReply {
  id          String   @id @default(cuid())
  reviewId    String   @unique
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  adminUserId String
  admin       User     @relation("AdminReplies", fields: [adminUserId], references: [id])
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ReviewVotes", fields: [userId], references: [id])
  isHelpful Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model VariantAttribute {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int             @default(0)
  options   VariantOption[]
  createdAt DateTime        @default(now())

  @@index([productId])
}

model VariantOption {
  id          String                 @id @default(cuid())
  attributeId String
  attribute   VariantAttribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  position    Int                    @default(0)
  variants    ProductVariantOption[]
  createdAt   DateTime               @default(now())

  @@index([attributeId])
}

model ProductVariant {
  id         String                 @id @default(cuid())
  productId  String
  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?                @unique
  price      Int
  stock      Int                    @default(0)
  weightGram Int                    @default(500)
  imageUrl   String?
  isActive   Boolean                @default(true)
  deletedAt  DateTime?
  options    ProductVariantOption[]
  orderItems OrderItem[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([productId])
}

model ProductVariantOption {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String
  option    VariantOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
}

model Address {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String?
  recipient       String
  phone           String
  address         String
  city            String?
  postalCode      String?
  isMain          Boolean  @default(false)
  latitude        Float?
  longitude       Float?
  pinpointAddress String?
  streetName      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Pet {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  type                String // Kucing, Anjing, Ikan, Burung, Reptil, Lainnya
  breed               String?
  birthDate           DateTime?
  vaccineReminderAt   DateTime?
  groomingReminderAt  DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
}
