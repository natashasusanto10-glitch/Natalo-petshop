  breed              String?
  birthDate          DateTime?
  vaccineReminderAt  DateTime?
  groomingReminderAt DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

/// Pengumuman yang muncul di notification center (bell icon). 2 jenis:
///
/// 1. BROADCAST — `targetUserId == null`, `segment` menentukan reach
///    ("all" | "members" | "active30d"). Dibuat oleh admin via dashboard.
///
/// 2. PERSONAL — `targetUserId == <userId>`, cuma user ybs yang lihat.
///    Auto-generated oleh sistem (mis. order status update "Pesanan
///    Dikirim", "Pembayaran Diterima") — dipasangkan dgn push channel
///    delivery di lib/push.ts.
///
/// Channel push (web/APNs/FCM) tetap dikirim paralel — Announcement
/// adalah lapis "in-app fallback" supaya user yg gak opt-in push masih
/// dapat info saat buka app.
model Announcement {
  id           String             @id @default(cuid())
  title        String
  body         String
  url          String? // deep link (default "/")
  segment      String             @default("all") // "all" | "members" | "active30d"
  type         String             @default("announcement") // "order" | "promo" | "feed" | "announcement"
  ctaLabel     String?
  startsAt     DateTime?
  endsAt       DateTime?
  publishedAt  DateTime?
  status       String             @default("PUBLISHED") // "PUBLISHED" | "DRAFT"
  /// Optional structured metadata for system-generated notifications.
  /// Feed keeps `type = "feed"` for Notification Center tab routing and
  /// writes the specific event into `eventType` (e.g. feed_post_approved).
  source       String?
  eventType    String?
  feedPostId   String?
  thumbnailUrl String?
  feedStatus   String?
  /// Kalau di-set, override segment — cuma user ini yang lihat di bell.
  /// Dipakai untuk personal notification (order status, dll).
  targetUserId String?
  createdAt    DateTime           @default(now())
  reads        AnnouncementRead[]

  @@index([createdAt])
  @@index([segment])
  @@index([type])
  @@index([status])
  @@index([source])
  @@index([eventType])
  @@index([feedPostId])
  @@index([targetUserId])
}

/// Track baca per user per announcement. Tidak ada read → unread.
/// Composite PK = (userId, announcementId) → idempotent INSERT,
/// gak perlu upsert.
model AnnouncementRead {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
}

// ─────────────────────────────────────────────────────────────────────
// FEED — In-app feed video + promo + community content (F1 foundation).
//
// Catatan desain:
// - Single FeedPost table dgn `kind` enum membedakan 4 jenis admin
//   (VIDEO_ONLY, PRODUCT_ONLY, VIDEO_PRODUCT, PROMO) + 1 user (COMMUNITY).
// - `tab` enum routing ke 3 tab di UI (REKOMENDASI / PROMO / KOMUNITAS).
//   Admin set saat post; user COMMUNITY otomatis ke KOMUNITAS.
// - `status` workflow: PENDING_REVIEW (user upload menunggu) → ACTIVE →
//   HIDDEN (admin sembunyikan), atau langsung REJECTED. Admin posts
//   auto-ACTIVE saat publish (di-set di app code, bukan default schema).
// - Denormalized count fields (likeCount/commentCount/viewCount) supaya
//   feed listing tidak butuh COUNT() subquery. Maintain via service layer.
// - thumbnailUrl wajib untuk video posts → Capacitor optimization (paint
//   thumbnail dulu, video baru load saat viewport). Client-side extract
//   via Canvas API (lihat docs F4 saat user upload diimplement).
// ─────────────────────────────────────────────────────────────────────

enum FeedPostKind {
  VIDEO_ONLY // Admin: konten edukasi/informasi tanpa produk
  PRODUCT_ONLY // Admin: card produk ringan (tanpa video) di feed
  VIDEO_PRODUCT // Admin: video jualan dgn produk terkait
  PROMO // Admin: banner/video promo dgn pricing diskon
  COMMUNITY // User: video komunitas (review/pengalaman/tips)
  PHOTO_CAROUSEL // User/Admin: 1-8 foto, single image atau carousel
}

enum FeedPostTab {
  REKOMENDASI // Mix admin content + approved community
  PROMO // Admin promo official
  KOMUNITAS // User-uploaded community videos
}

enum FeedPostStatus {
  PENDING_REVIEW // User upload menunggu moderasi admin
  ACTIVE // Publik, tampil di feed
  REJECTED // Admin tolak (alasan di moderationNote)
  HIDDEN // Sebelumnya ACTIVE, di-hide admin (bisa di-unhide)
}

enum FeedReportTargetType {
  POST
  COMMENT
}

enum FeedReportReason {
  SPAM
  INAPPROPRIATE
  MISLEADING
  COPYRIGHT
  OTHER
}

enum FeedReportStatus {
  PENDING
  RESOLVED // Admin took action (hide/delete)
  DISMISSED // Admin reviewed, no violation
}

model FeedPost {
  id         String         @id @default(cuid())
  authorId   String
  author     User           @relation("FeedAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Snapshot author role at post time. Sebenarnya derive dari author.role,
  // tapi cache di sini supaya moderation query tidak join User tiap kali.
  authorRole String // "ADMIN" | "CUSTOMER"
  kind       FeedPostKind
  tab        FeedPostTab
  status     FeedPostStatus @default(ACTIVE)

  title       String
  description String?

  // Video fields — nullable untuk PRODUCT_ONLY (kind tanpa video).
  videoUrl          String?
  videoMimeType     String?
  videoSizeBytes    Int?
  videoDurationSec  Int?
  videoWidth        Int?
  videoHeight       Int?
  thumbnailUrl      String? // Wajib kalau ada videoUrl
  // Blurhash LQIP — string ~30 byte yang di-decode ke canvas 32x32 di
  // client sebagai placeholder instan sebelum thumbnailUrl fully decoded.
  // Generated server-side di Bunny webhook saat thumbnail tersedia.
  // Nullable untuk legacy post yang belum di-backfill — UI fallback ke
  // bg-black solid.
  thumbnailBlurhash String?
  // Bunny Stream integration. NULL = post pakai UploadThing direct URL
  // (legacy). Saat di-set, videoUrl menyimpan playlist.m3u8 dari Bunny CDN
  // dan playback pakai HLS adaptive bitrate.
  videoGuid         String? @unique
  // Encoding lifecycle untuk Bunny videos.
  //   "ready"      — playable (default untuk UploadThing legacy posts)
  //   "uploading"  — user sedang upload raw file ke Bunny
  //   "processing" — Bunny sedang encode HLS variants
  //   "failed"     — Bunny encode gagal, post tidak boleh tayang
  encodingStatus    String  @default("ready")

  // Publish-push: opsi "Beri tahu pelanggan" saat admin publish.
  notifyOnPublish   Boolean   @default(false)
  pushSegment       String?   // "all" | "members" | "active30d"
  publishPushSentAt DateTime? // guard idempoten — set saat push terkirim

  // Product linkage — nullable untuk VIDEO_ONLY + COMMUNITY tanpa tag.
  // COMMUNITY user yg tag produk: arahkan ke produk resmi (bukan toko user).
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Promo-specific (kind == PROMO). Skip kalau bukan promo.
  promoOriginalPrice Int?
  promoDiscountPrice Int?
  promoStartsAt      DateTime?
  promoEndsAt        DateTime?

  // Denormalized engagement counters — maintained oleh service layer.
  // Pakai @default(0) supaya tidak null saat insert.
  likeCount    Int @default(0)
  commentCount Int @default(0)
  viewCount    Int @default(0)
  // Increment via POST /api/feed/posts/[id]/share after the platform's
  // native share dialog resolves successfully. Cancelled/failed shares
  // do not count.
  shareCount   Int @default(0)

  // Moderation trail
  moderatedById  String?
  moderatedBy    User?     @relation("FeedModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt    DateTime?
  moderationNote String? // Reason kalau REJECTED/HIDDEN

  publishedAt DateTime? // Saat status pertama kali ACTIVE
  // Soft-delete marker. NULL = post masih ada. Saat di-set, row tetap di
  // DB (untuk audit + restore) tapi feed listing query harus filter out.
  // Cleanup helper masih boleh wipe UploadThing assets — restore akan
  // re-upload kalau benar-benar perlu.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments       FeedComment[]
  likes          FeedLike[]
  reports        FeedReport[]
  moderationLogs FeedModerationLog[]
  // Shop the Look: many-to-many ke Product (up to 3 tags per post).
  // FeedPost.productId tetap dipertahankan untuk legacy + primary product
  // display. taggedProducts adalah source of truth untuk multi-tag carousel.
  taggedProducts FeedPostProduct[]
  // PHOTO_CAROUSEL kind: 1-8 image media. Untuk video kind, field ini
  // empty (video tetap stored di FeedPost.videoUrl / thumbnailUrl /
  // videoGuid sebagai single-asset legacy fields).
  media          FeedMedia[]

  // Index utama untuk feed listing (filter by tab + status + sorted).
  @@index([tab, status, publishedAt])
  // User profile / "my posts" — list semua post oleh author tertentu.
  @@index([authorId, status, createdAt])
  // Product detail page bisa show "video yang pakai produk ini".
  @@index([productId, status])
  // Admin moderation queue — list PENDING_REVIEW sorted oldest first.
  @@index([status, createdAt])
  // Soft-deleted listing untuk admin trash view.
  @@index([deletedAt])
}

/// Generic media model untuk FeedPost — saat ini dipakai untuk
/// PHOTO_CAROUSEL kind (1-8 image per post). Video kind tetap pakai
/// FeedPost.videoUrl/videoGuid/thumbnailUrl direct fields (legacy
/// single-asset model). Bisa di-extend ke video later (mis. multi-clip
/// reels) tanpa breaking change.
///
/// Storage: UploadThing (sama dengan profile photo + admin uploads),
/// uploadthingKey disimpan untuk cleanup saat post di-delete.
model FeedMedia {
  id             String   @id @default(cuid())
  postId         String
  post           FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// "image" | "video" — discriminator untuk future-proof. Sekarang
  /// hanya "image" yang dipakai (PHOTO_CAROUSEL). Video tetap di
  /// FeedPost.videoUrl.
  mediaType      String   @default("image")
  url            String
  /// Optional — untuk image biasanya null (URL itself adalah final),
  /// untuk video bisa dipakai sebagai poster thumbnail.
  thumbnailUrl   String?
  /// UploadThing file key — disimpan untuk hard-delete asset saat post
  /// di-delete via /admin/feed/posts/[id]/cleanup.
  uploadthingKey String?
  /// Order index untuk carousel display — 0 = first/cover, 1, 2, ...
  /// User pilih foto urutan tertentu, sortOrder mempertahankan urutan.
  sortOrder      Int      @default(0)
  /// Optional dimensions — untuk pre-compute aspect ratio di client
  /// sebelum image fully loaded (better UX, no layout shift).
  width          Int?
  height         Int?
  createdAt      DateTime @default(now())

  @@index([postId, sortOrder])
}

// Shop the Look — many-to-many ke produk yang di-tag di video.
// Sampai 3 produk per post customer / 5 admin (enforced di API layer).
// Position menentukan urutan carousel di feed UI.
// promoPrice: optional discount price per produk untuk PROMO video.
// Original price ambil dari Product.price (no need to denormalize).
model FeedPostProduct {
  id         String   @id @default(cuid())
  feedPostId String
  feedPost   FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int      @default(0) // 0..2 untuk urutan tampilan
  promoPrice Int? // Discount price untuk produk ini di video PROMO.
  // null = no per-product discount (gunakan price normal).
  createdAt  DateTime @default(now())

  // Tidak boleh tag produk sama dua kali di post yang sama.
  @@unique([feedPostId, productId])
  // Index untuk "Postingan Pelanggan" tab di product page —
  // query: WHERE productId=X JOIN FeedPost sorted by createdAt desc.
  @@index([productId])
  @@index([feedPostId, position])
}

// Audit trail untuk semua moderation transition di FeedPost. Append-only —
// admin tidak boleh edit/delete entries (Prisma client + UI block update).
// Setiap row mencatat siapa lakukan apa, kapan, dengan note opsional.
model FeedModerationLog {
  id         String   @id @default(cuid())
  postId     String
  post       FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation("FeedModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String // "approve" | "reject" | "hide" | "unhide" | "delete" | "restore"
  fromStatus String? // Status sebelum action (null kalau create)
  toStatus   String? // Status sesudah action
  note       String? // Reason kalau reject/hide
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
  @@index([actorId, createdAt])
}

model FeedComment {
  id              String        @id @default(cuid())
  postId          String
  post            FeedPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation("FeedCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Threading: 1 level. Admin "balas sebagai Natalo Official" set parentCommentId
  // ke comment user. Tidak ada nested reply lebih dalam (UX simple).
  parentCommentId String?
  parent          FeedComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         FeedComment[] @relation("CommentReplies")

  content         String
  // Flag admin official reply — UI render dgn badge "Natalo Official".
  // Cache di sini supaya tidak harus join User.role tiap kali.
  isAdminOfficial Boolean @default(false)

  // Moderation
  isHidden     Boolean   @default(false)
  hiddenById   String?
  hiddenBy     User?     @relation("FeedCommentModerator", fields: [hiddenById], references: [id], onDelete: SetNull)
  hiddenAt     DateTime?
  hiddenReason String?

  /// Self-delete marker — user hapus komentar sendiri. Berbeda dari
  /// isHidden (admin moderation):
  ///   - isHidden = admin block konten yang melanggar
  ///   - deletedAt = user voluntary remove komen mereka
  /// Listing query filter deletedAt = null. Reply ke komentar yang
  /// di-self-delete tetap visible (placeholder "Komentar dihapus" di UI
  /// untuk parent supaya thread tetep readable).
  deletedAt DateTime?

  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes   FeedCommentLike[]
  reports FeedReport[]

  @@index([postId, isHidden, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
}

/// Composite PK (userId, postId) — natural unique, idempotent like toggle.
model FeedLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

/// Separate table dari FeedLike supaya query bersih (like comment vs like post
/// punya counter berbeda). Mirip pattern ReviewVote.
model FeedCommentLike {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   FeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([userId, commentId])
  @@index([commentId])
}

/// Report user untuk post atau comment. Admin queue lewat status=PENDING.
model FeedReport {
  id         String               @id @default(cuid())
  reporterId String
  reporter   User                 @relation("FeedReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType FeedReportTargetType
  // Exactly one of postId/commentId terisi (constraint di service layer).
  postId     String?
  post       FeedPost?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    FeedComment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reason FeedReportReason
  detail String?

  status       FeedReportStatus @default(PENDING)
  resolvedById String?
  resolvedBy   User?            @relation("FeedReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([postId])
  @@index([commentId])
}

// Search query logs untuk auto-generate "Pencarian populer" (7d) di home/search
// overlay. Append-only; cleanup periodic via cron jika perlu.
model SearchLog {
  id        String   @id @default(cuid())
  keyword   String // normalized lowercase
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([keyword, createdAt])
}

// ────────────────────────────────────────────────────────────────────
// REFUND WALLET — Saldo Refund untuk dana pengembalian dari admin.
//
// Bukan e-wallet umum: TIDAK ada user top-up, transfer antar user,
// atau tarik dana. Hanya admin yang bisa credit (saat produk kosong,
// partial cancel, return approved). User bisa pakai saldo di checkout
// sebagai pengurang sisa pembayaran.
//
// Atomic guarantee: setiap perubahan balance HARUS via
// `lib/refund-wallet.ts` helper yang wrap di prisma.$transaction +
// create RefundWalletLedger entry. Direct mutate balance = forbidden
// (no audit trail).
// ────────────────────────────────────────────────────────────────────

enum RefundWalletStatus {
  ACTIVE
  // Admin lock — kalau ada fraud suspicion, freeze wallet supaya
  // user tidak bisa pakai saldo. Existing balance tetap tersimpan.
  FROZEN
}

enum RefundLedgerType {
  // Saldo bertambah dari refund admin (kasus: produk kosong, return).
  CREDIT
  // Saldo dipakai user saat checkout pesanan.
  DEBIT
  // Saldo balik karena order yang pakai saldo di-cancel/refund.
  REVERSAL
  // Admin manual adjustment (correction, bonus, dll).
  ADJUSTMENT
}

enum RefundCaseReason {
  // Produk kosong saat packing — admin tidak bisa fulfill.
  OUT_OF_STOCK
  // Admin cancel sebagian item dari order (mis. logistik issue).
  PARTIAL_CANCEL
  // User request return dan admin approve setelah produk diterima.
  RETURN_APPROVED
  // Full order di-cancel admin (semua item issue).
  ORDER_CANCELLED
  // Alasan lain (admin manual override dengan catatan).
  OTHER
}

enum RefundCaseStatus {
  // Refund case dibuat tapi belum di-process (admin draft).
  PENDING
  // Admin approve — siap di-credit.
  APPROVED
  // Sudah credit ke wallet (ledger entry exists).
  CREDITED
  // Admin reject (mis. user fraud detected).
  REJECTED
}

enum RefundCaseDestination {
  // Default — credit ke saldo refund user (instant, in-app).
  REFUND_BALANCE
  // V2 future — refund balik ke metode pembayaran original
  // (bank/wallet, 3-7 hari). Belum di-implement di MVP.
  ORIGINAL_PAYMENT
}

model RefundWallet {
  id               String               @id @default(cuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Rupiah, no decimal. Always >= 0. Atomic update via helper.
  availableBalance Int                  @default(0)
  // Reserved untuk in-flight refund yang belum complete (mis. saldo
  // dipakai di order PAID tapi belum DELIVERED). Tidak dipakai di MVP,
  // reserved untuk V2.
  pendingBalance   Int                  @default(0)
  status           RefundWalletStatus   @default(ACTIVE)
  ledgers          RefundWalletLedger[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

model RefundWalletLedger {
  id                 String           @id @default(cuid())
  walletId           String
  wallet             RefundWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  // Denormalized userId untuk query speed (avoid join wallet).
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               RefundLedgerType
  // Always positive — type defines direction (CREDIT/DEBIT/REVERSAL).
  amount             Int
  // Snapshot balance untuk audit (recompute & verify integrity).
  balanceBefore      Int
  balanceAfter       Int
  // Reference ke order yang trigger (CREDIT dari refund / DEBIT dari pesanan).
  sourceOrderId      String?
  // Reference ke RefundCase (CREDIT entry punya ini).
  sourceRefundCaseId String?
  // Free-text untuk display di user history.
  note               String?
  // Admin yang trigger entry ini (CREDIT/ADJUSTMENT). Null untuk DEBIT
  // (user action) atau REVERSAL (system-triggered).
  createdByAdminId   String?
  createdAt          DateTime         @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([sourceOrderId])
  @@index([sourceRefundCaseId])
}

model RefundCase {
  id                 String                @id @default(cuid())
  orderId            String
  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Null untuk full-order refund. Set untuk per-item refund.
  orderItemId        String?
  orderItem          OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason             RefundCaseReason
  // Final refund amount setelah voucher allocation calculation.
  amount             Int
  // Snapshot per-voucher allocation untuk audit + dispute.
  // Format: { "DISKON15": 6000, "POIN50K": 20000 }
  voucherAllocations Json?
  // Snapshot saldo refund allocation kalau order ini pakai saldo.
  // Format: { "wasUsedAmount": 20000, "reversalAmount": 8000 }
  saldoAllocation    Json?
  destination        RefundCaseDestination @default(REFUND_BALANCE)
  status             RefundCaseStatus      @default(PENDING)
  // Catatan dari admin untuk user (display di history).
  adminNote          String?
  // Admin yang create case (untuk audit).
  createdByAdminId   String?
  // Ledger entry yang di-create saat status jadi CREDITED.
  // Null sampai status berubah ke CREDITED.
  ledgerEntryId      String?
  createdAt          DateTime              @default(now())
  approvedAt         DateTime?
  creditedAt         DateTime?

  @@index([orderId])
  @@index([orderItemId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([reason])
}

/// Voucher abuse flag — di-create oleh cron detection job saat
/// nemu pola mencurigakan. Admin review via /admin/abuse-flags.
///
/// Rule codes (lihat lib/abuse-detection.ts):
///   - BURST_VOUCHER_CLAIM — user claim >3 voucher dalam 1 jam
///   - GMAIL_ALIAS_DUPLICATE — email gmail alias (dot/plus) → multi-akun
///   - DUPLICATE_SHIPPING_ADDRESS — same address dipakai 3+ user
///   - NEW_ACCOUNT_INSTANT_CLAIM — register lalu claim <5 menit
///
/// Severity:
///   - LOW  — pola weak signal, mungkin coincidence
///   - MEDIUM — pola jelas tapi belum confirmed abuse
///   - HIGH — strong signal, butuh review urgent
model AbuseFlag {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("AbuseFlagTarget", fields: [userId], references: [id], onDelete: Cascade)
  ruleCode          String
  severity          String   @default("MEDIUM")
  details           Json?
  status            String   @default("OPEN")
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedBy        User?    @relation("AbuseFlagReviewer", fields: [reviewedByAdminId], references: [id])
  adminNote         String?
  createdAt         DateTime @default(now())

  @@index([userId, status])
  @@index([status, severity, createdAt])
  @@index([ruleCode, createdAt])
  @@index([createdAt])
}
