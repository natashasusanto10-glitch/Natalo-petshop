generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  MIDTRANS
  XENDIT
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum VoucherSourceType {
  // Voucher publik admin promo + voucher claim user (BDAY, POIN). Tampil
  // di daftar voucher pembeli. Maks 1 per checkout.
  CUSTOMER
  // Voucher rahasia dari penjual. TIDAK muncul di daftar publik. Hanya
  // bisa di-apply via input kode manual. Maks 1 per checkout.
  SELLER_MANUAL
}

model User {
  id                  String          @id @default(cuid())
  name                String
  phone               String?         @unique
  email               String?         @unique
  passwordHash        String?
  role                String          @default("CUSTOMER")
  tokenVersion        Int             @default(0)
  birthDate           DateTime?
  birthdayVoucherYear Int?
  orders              Order[]
  points              CustomerPoint[]
  reviews             Review[]
  reviewReplies       ReviewReply[]   @relation("AdminReplies")
  reviewVotes         ReviewVote[]    @relation("ReviewVotes")
  addresses           Address[]
  favorites           Favorite[]
  pets                Pet[]
  chatThreads         ChatThread[]     @relation("CustomerChatThreads")
  chatMessages        ChatMessage[]    @relation("ChatSender")
  cartItems           CartItem[]
  productViews        UserProductView[]
  announcementReads   AnnouncementRead[]
  // Feed relations — admin post & user community video, plus engagement.
  feedPosts           FeedPost[]      @relation("FeedAuthor")
  moderatedFeedPosts  FeedPost[]      @relation("FeedModerator")
  feedComments        FeedComment[]   @relation("FeedCommentAuthor")
  hiddenComments      FeedComment[]   @relation("FeedCommentModerator")
  feedLikes           FeedLike[]
  feedCommentLikes    FeedCommentLike[]
  feedReportsFiled    FeedReport[]    @relation("FeedReporter")
  feedReportsResolved FeedReport[]    @relation("FeedReportResolver")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model CartItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String?
  variantLabel String?
  name         String
  price        Int
  quantity     Int
  weightGram   Int      @default(500)
  imageUrl     String?
  stock        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true) @map("is_active")
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  description       String
  price             Int
  memberPrice       Int?
  discountPrice     Int?
  stock             Int                @default(0)
  weightGram        Int                @default(500)
  imageUrl          String?
  // Galeri tambahan (max 4 gambar). imageUrl tetap jadi thumbnail utama,
  // gallery dipakai di halaman detail produk untuk carousel.
  gallery           String[]           @default([])
  isActive          Boolean            @default(true)
  hasVariants       Boolean            @default(false)
  brandAutoAssigned Boolean            @default(false)
  avgRating         Float              @default(0)
  reviewCount       Int                @default(0)
  ratingBreakdown   Json?
  // Denormalized search text (name + brand + variant names + sku codes).
  // Di-maintain oleh app code (lib/search.ts syncProduct) + script backfill.
  // GIN trigram index ada di migration product_search_text_trgm.
  searchText        String             @default("") @map("searchText")
  categoryId        String?
  category          Category?          @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?             @relation(fields: [brandId], references: [id])
  orderItems        OrderItem[]
  reviews           Review[]
  variants          ProductVariant[]
  variantAttrs      VariantAttribute[]
  favorites         Favorite[]
  viewedBy          UserProductView[]
  recommendationSources ProductRecommendationRule[] @relation("RecommendationSource")
  recommendationTargets ProductRecommendationRule[] @relation("RecommendationTarget")
  // Feed posts yang tag/link ke produk ini (admin product card, promo, video+product).
  feedPosts         FeedPost[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model UserProductView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @map("viewed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@index([productId])
  @@map("user_product_views")
}

model ProductRecommendationRule {
  id                   String   @id @default(cuid())
  sourceProductId       String   @map("source_product_id")
  sourceProduct         Product  @relation("RecommendationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  recommendedProductId  String   @map("recommended_product_id")
  recommendedProduct    Product  @relation("RecommendationTarget", fields: [recommendedProductId], references: [id], onDelete: Cascade)
  relationType          String   @default("complementary") @map("relation_type")
  priority              Int      @default(0)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([sourceProductId, recommendedProductId, relationType])
  @@index([sourceProductId, isActive, priority])
  @@index([recommendedProductId])
  @@map("product_recommendation_rules")
}

model Order {
  id                  String          @id @default(cuid())
  orderNumber          String          @unique
  userId               String?
  user                 User?           @relation(fields: [userId], references: [id])
  customerName         String
  customerPhone        String
  customerEmail        String?
  shippingAddress      String
  shippingCity         String?
  shippingPostalCode   String?
  shippingLatitude     Float?
  shippingLongitude    Float?
  shippingPinpointAddress String?
  shippingAreaId       String?
  shippingAreaLabel    String?
  shippingProvinceName String?
  shippingDistrictName String?
  orderType            String          @default("DELIVERY")
  shippingMethod       String          @default("DELIVERY")
  courierCode          String?
  courierService       String?
  trackingNumber       String?
  trackingToken        String?         @unique
  biteshipOrderId      String?
  biteshipTrackingUrl  String?
  shipmentStatus       String?
  biteshipRequest      Json?
  biteshipResponse     Json?
  biteshipError        String?
  pickupStoreName      String?
  pickupStoreAddress   String?
  pickupStoreLatitude  Float?
  pickupStoreLongitude Float?
  pickupHours          String?
  pickupCode           String?         @unique
  pickupQrCode         String?
  pickupStatus         String?
  readyForPickupAt     DateTime?
  pickedUpAt           DateTime?
  pickedUpByAdminId    String?
  subtotal             Int
  shippingCost         Int             @default(0)
  discount             Int             @default(0)
  total                Int
  status               OrderStatus     @default(PENDING)
  paymentProvider      PaymentProvider @default(MANUAL)
  paymentStatus        PaymentStatus   @default(UNPAID)
  paymentReference     String?
  paymentUrl           String?
  paymentProofUrl      String?
  manualBank           String?
  uniqueCode           Int?
  voucherCode          String? // Customer voucher (CUSTOMER source type)
  manualVoucherCode    String? // Seller manual voucher (SELLER_MANUAL)
  notes                String?
  items                OrderItem[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([biteshipOrderId])
  @@index([shipmentStatus])
  @@index([orderType])
  @@index([pickupStatus])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  variantLabel String? // snapshot: "4KG / Beef" — tidak berubah meski variant diedit
  name         String
  price        Int
  quantity     Int
  weightGram   Int             @default(500)
  reviews      Review[] // multiple kalau user soft-delete & resubmit
}

model Voucher {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountPercent Int?
  discountAmount  Int?
  minimumOrder    Int       @default(0)
  maxUsage        Int?
  usedCount       Int       @default(0)
  startsAt        DateTime  @default(now())
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  // Voucher milik user spesifik (BDAY, POIN claim). NULL = voucher publik (admin promo).
  userId          String?
  // Source type: CUSTOMER (visible di daftar pembeli) vs SELLER_MANUAL
  // (tersembunyi, hanya via input kode manual). Default CUSTOMER untuk
  // backward compat semua voucher existing.
  sourceType      VoucherSourceType @default(CUSTOMER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  createdAt DateTime @default(now())
}

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation("CustomerChatThreads", fields: [userId], references: [id], onDelete: Cascade)
  status    String        @default("OPEN")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User       @relation("ChatSender", fields: [senderId], references: [id])
  senderRole String
  content    String
  readAt     DateTime?
  createdAt  DateTime   @default(now())

  @@index([threadId, createdAt])
  @@index([senderRole, readAt])
}

model CustomerPoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  source    String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?            // null = belum dipakai
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RegistrationOtp {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String
  passwordHash String
  channel      String
  otpHash      String
  expiresAt    DateTime
  attempts     Int       @default(0)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

enum ReviewStatus {
  VISIBLE
  HIDDEN // di-hide oleh admin
  DELETED // soft-delete oleh user (boleh resubmit)
}

model Review {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String? // referensi varian (null untuk produk non-varian)
  variantLabel String? // snapshot teks dari OrderItem
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  orderItemId  String // 1 review aktif per order_item — diatur di service layer (bukan @unique karena boleh resubmit)
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  rating       Int // 1–5
  title        String?
  content      String?
  status       ReviewStatus  @default(VISIBLE)
  hiddenReason String?
  helpfulCount Int           @default(0)
  images       ReviewImage[]
  reply        ReviewReply?
  votes        ReviewVote[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId, status, createdAt])
  @@index([userId])
  @@index([orderItemId])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl  String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ReviewReply {
  id          String   @id @default(cuid())
  reviewId    String   @unique
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  adminUserId String
  admin       User     @relation("AdminReplies", fields: [adminUserId], references: [id])
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ReviewVotes", fields: [userId], references: [id])
  isHelpful Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model VariantAttribute {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int             @default(0)
  options   VariantOption[]
  createdAt DateTime        @default(now())

  @@index([productId])
}

model VariantOption {
  id          String                 @id @default(cuid())
  attributeId String
  attribute   VariantAttribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  position    Int                    @default(0)
  variants    ProductVariantOption[]
  createdAt   DateTime               @default(now())

  @@index([attributeId])
}

model ProductVariant {
  id         String                 @id @default(cuid())
  productId  String
  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?                @unique
  price      Int
  stock      Int                    @default(0)
  weightGram Int                    @default(500)
  imageUrl   String?
  isActive   Boolean                @default(true)
  deletedAt  DateTime?
  options    ProductVariantOption[]
  orderItems OrderItem[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([productId])
}

model ProductVariantOption {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String
  option    VariantOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
}

model Address {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String?
  recipient       String
  phone           String
  address         String
  city            String?
  postalCode      String?
  areaId          String?
  areaLabel       String?
  provinceName    String?
  cityName        String?
  districtName    String?
  isMain          Boolean  @default(false)
  latitude        Float?
  longitude       Float?
  pinpointAddress String?
  streetName      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Pet {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  type                String // Kucing, Anjing, Ikan, Burung, Reptil, Lainnya
  breed               String?
  birthDate           DateTime?
  vaccineReminderAt   DateTime?
  groomingReminderAt  DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
}

/// Pengumuman yang muncul di notification center (bell icon). 2 jenis:
///
/// 1. BROADCAST — `targetUserId == null`, `segment` menentukan reach
///    ("all" | "members" | "active30d"). Dibuat oleh admin via dashboard.
///
/// 2. PERSONAL — `targetUserId == <userId>`, cuma user ybs yang lihat.
///    Auto-generated oleh sistem (mis. order status update "Pesanan
///    Dikirim", "Pembayaran Diterima") — dipasangkan dgn push channel
///    delivery di lib/push.ts.
///
/// Channel push (web/APNs/FCM) tetap dikirim paralel — Announcement
/// adalah lapis "in-app fallback" supaya user yg gak opt-in push masih
/// dapat info saat buka app.
model Announcement {
  id           String             @id @default(cuid())
  title        String
  body         String
  url          String?            // deep link (default "/")
  segment      String             @default("all")  // "all" | "members" | "active30d"
  type         String             @default("announcement") // "order" | "promo" | "announcement"
  ctaLabel     String?
  startsAt     DateTime?
  endsAt       DateTime?
  publishedAt  DateTime?
  status       String             @default("PUBLISHED") // "PUBLISHED" | "DRAFT"
  /// Kalau di-set, override segment — cuma user ini yang lihat di bell.
  /// Dipakai untuk personal notification (order status, dll).
  targetUserId String?
  createdAt    DateTime           @default(now())
  reads        AnnouncementRead[]

  @@index([createdAt])
  @@index([segment])
  @@index([type])
  @@index([status])
  @@index([targetUserId])
}

/// Track baca per user per announcement. Tidak ada read → unread.
/// Composite PK = (userId, announcementId) → idempotent INSERT,
/// gak perlu upsert.
model AnnouncementRead {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
}

// ─────────────────────────────────────────────────────────────────────
// FEED — In-app feed video + promo + community content (F1 foundation).
//
// Catatan desain:
// - Single FeedPost table dgn `kind` enum membedakan 4 jenis admin
//   (VIDEO_ONLY, PRODUCT_ONLY, VIDEO_PRODUCT, PROMO) + 1 user (COMMUNITY).
// - `tab` enum routing ke 3 tab di UI (REKOMENDASI / PROMO / KOMUNITAS).
//   Admin set saat post; user COMMUNITY otomatis ke KOMUNITAS.
// - `status` workflow: PENDING_REVIEW (user upload menunggu) → ACTIVE →
//   HIDDEN (admin sembunyikan), atau langsung REJECTED. Admin posts
//   auto-ACTIVE saat publish (di-set di app code, bukan default schema).
// - Denormalized count fields (likeCount/commentCount/viewCount) supaya
//   feed listing tidak butuh COUNT() subquery. Maintain via service layer.
// - thumbnailUrl wajib untuk video posts → Capacitor optimization (paint
//   thumbnail dulu, video baru load saat viewport). Client-side extract
//   via Canvas API (lihat docs F4 saat user upload diimplement).
// ─────────────────────────────────────────────────────────────────────

enum FeedPostKind {
  VIDEO_ONLY      // Admin: konten edukasi/informasi tanpa produk
  PRODUCT_ONLY    // Admin: card produk ringan (tanpa video) di feed
  VIDEO_PRODUCT   // Admin: video jualan dgn produk terkait
  PROMO           // Admin: banner/video promo dgn pricing diskon
  COMMUNITY       // User: video komunitas (review/pengalaman/tips)
}

enum FeedPostTab {
  REKOMENDASI     // Mix admin content + approved community
  PROMO           // Admin promo official
  KOMUNITAS       // User-uploaded community videos
}

enum FeedPostStatus {
  PENDING_REVIEW  // User upload menunggu moderasi admin
  ACTIVE          // Publik, tampil di feed
  REJECTED        // Admin tolak (alasan di moderationNote)
  HIDDEN          // Sebelumnya ACTIVE, di-hide admin (bisa di-unhide)
}

enum FeedReportTargetType {
  POST
  COMMENT
}

enum FeedReportReason {
  SPAM
  INAPPROPRIATE
  MISLEADING
  COPYRIGHT
  OTHER
}

enum FeedReportStatus {
  PENDING
  RESOLVED        // Admin took action (hide/delete)
  DISMISSED       // Admin reviewed, no violation
}

model FeedPost {
  id              String          @id @default(cuid())
  authorId        String
  author          User            @relation("FeedAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Snapshot author role at post time. Sebenarnya derive dari author.role,
  // tapi cache di sini supaya moderation query tidak join User tiap kali.
  authorRole      String          // "ADMIN" | "CUSTOMER"
  kind            FeedPostKind
  tab             FeedPostTab
  status          FeedPostStatus  @default(ACTIVE)

  title           String
  description     String?

  // Video fields — nullable untuk PRODUCT_ONLY (kind tanpa video).
  videoUrl        String?
  videoMimeType   String?
  videoSizeBytes  Int?
  videoDurationSec Int?
  videoWidth      Int?
  videoHeight     Int?
  thumbnailUrl    String?         // Wajib kalau ada videoUrl

  // Product linkage — nullable untuk VIDEO_ONLY + COMMUNITY tanpa tag.
  // COMMUNITY user yg tag produk: arahkan ke produk resmi (bukan toko user).
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Promo-specific (kind == PROMO). Skip kalau bukan promo.
  promoOriginalPrice Int?
  promoDiscountPrice Int?
  promoStartsAt      DateTime?
  promoEndsAt        DateTime?

  // Denormalized engagement counters — maintained oleh service layer.
  // Pakai @default(0) supaya tidak null saat insert.
  likeCount       Int             @default(0)
  commentCount    Int             @default(0)
  viewCount       Int             @default(0)

  // Moderation trail
  moderatedById   String?
  moderatedBy     User?           @relation("FeedModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt     DateTime?
  moderationNote  String?         // Reason kalau REJECTED/HIDDEN

  publishedAt     DateTime?       // Saat status pertama kali ACTIVE
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comments        FeedComment[]
  likes           FeedLike[]
  reports         FeedReport[]

  // Index utama untuk feed listing (filter by tab + status + sorted).
  @@index([tab, status, publishedAt])
  // User profile / "my posts" — list semua post oleh author tertentu.
  @@index([authorId, status, createdAt])
  // Product detail page bisa show "video yang pakai produk ini".
  @@index([productId, status])
  // Admin moderation queue — list PENDING_REVIEW sorted oldest first.
  @@index([status, createdAt])
}

model FeedComment {
  id              String        @id @default(cuid())
  postId          String
  post            FeedPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation("FeedCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Threading: 1 level. Admin "balas sebagai Natalo Official" set parentCommentId
  // ke comment user. Tidak ada nested reply lebih dalam (UX simple).
  parentCommentId String?
  parent          FeedComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         FeedComment[] @relation("CommentReplies")

  content         String
  // Flag admin official reply — UI render dgn badge "Natalo Official".
  // Cache di sini supaya tidak harus join User.role tiap kali.
  isAdminOfficial Boolean       @default(false)

  // Moderation
  isHidden        Boolean       @default(false)
  hiddenById      String?
  hiddenBy        User?         @relation("FeedCommentModerator", fields: [hiddenById], references: [id], onDelete: SetNull)
  hiddenAt        DateTime?
  hiddenReason    String?

  likeCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  likes           FeedCommentLike[]
  reports         FeedReport[]

  @@index([postId, isHidden, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
}

/// Composite PK (userId, postId) — natural unique, idempotent like toggle.
model FeedLike {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      FeedPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([userId, postId])
  @@index([postId])
}

/// Separate table dari FeedLike supaya query bersih (like comment vs like post
/// punya counter berbeda). Mirip pattern ReviewVote.
model FeedCommentLike {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   FeedComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([userId, commentId])
  @@index([commentId])
}

/// Report user untuk post atau comment. Admin queue lewat status=PENDING.
model FeedReport {
  id          String                @id @default(cuid())
  reporterId  String
  reporter    User                  @relation("FeedReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  FeedReportTargetType
  // Exactly one of postId/commentId terisi (constraint di service layer).
  postId      String?
  post        FeedPost?             @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     FeedComment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reason      FeedReportReason
  detail      String?

  status      FeedReportStatus      @default(PENDING)
  resolvedById String?
  resolvedBy  User?                 @relation("FeedReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?

  createdAt   DateTime              @default(now())

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([postId])
  @@index([commentId])
}

// Search query logs untuk auto-generate "Pencarian populer" (7d) di home/search
// overlay. Append-only; cleanup periodic via cron jika perlu.
model SearchLog {
  id        String   @id @default(cuid())
  keyword   String   // normalized lowercase
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([keyword, createdAt])
}
