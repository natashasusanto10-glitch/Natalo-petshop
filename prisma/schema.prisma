generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  MIDTRANS
  XENDIT
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum VoucherSourceType {
  // Voucher publik admin promo + voucher claim user (BDAY, POIN). Tampil
  // di daftar voucher pembeli. Maks 1 per checkout.
  CUSTOMER
  // Voucher rahasia dari penjual. TIDAK muncul di daftar publik. Hanya
  // bisa di-apply via input kode manual. Maks 1 per checkout.
  SELLER_MANUAL
}

enum VoucherType {
  PUBLIC_FREE_SHIPPING
  PUBLIC_PRODUCT_DISCOUNT
  LOYALTY_POINT_CLAIM
  PRIVATE_MANUAL_CODE
}

enum VoucherVisibility {
  PUBLIC
  PRIVATE
  USER_OWNED
}

enum VoucherDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum VoucherDiscountScope {
  PRODUCT
  SHIPPING
}

model User {
  id                  String               @id @default(cuid())
  name                String
  /// Public handle untuk @mention + URL profile (IG/TikTok style).
  /// Format: 3-30 char lowercase alfanumerik + `_` + `.` (no `..`,
  /// no leading/trailing `.`). Case-insensitive unique. Nullable
  /// untuk user existing yang belum pilih — UI tampil banner prompt
  /// + di feed fallback ke `name`. Mandatory di sign-up flow user
  /// baru.
  username            String?              @unique
  /// Timestamp terakhir kali username di-set/ganti. Dipakai untuk
  /// audit + future "min interval" rate limit. Nullable kalau user
  /// belum pernah set.
  usernameUpdatedAt   DateTime?
  phone               String?              @unique
  email               String?              @unique
  passwordHash        String?
  role                String               @default("CUSTOMER")
  tokenVersion        Int                  @default(0)
  birthDate           DateTime?
  birthdayVoucherYear Int?
  /// Tahun terakhir user dikirim teaser push "Besok ultahmu!" oleh
  /// cron /api/cron/birthday-reminder. Anti-spam: cek field ini sebelum
  /// kirim → tidak duplicate kalau cron re-run dalam hari yang sama.
  lastBirthdayTeaserYear Int?
  /// Timestamp lock birthDate. Diisi saat user dapat voucher ulang
  /// tahun pertama. Setelah field ini != null:
  ///   - API /api/member/profile reject perubahan birthDate (return 403)
  ///   - Flutter UI render tgl lahir read-only dengan hint
  ///   - Admin bisa override via endpoint admin manual (audit log)
  /// Pattern dari Shopee anti-abuse: cegah user ganti2 tgl lahir untuk
  /// trigger voucher ulang tahun di luar timing aslinya.
  birthDateLockedAt   DateTime?
  /// URL foto profil — disimpan ke UploadThing CDN. Nullable: user yang
  /// belum upload pakai fallback initial avatar di UI. Dipakai di feed
  /// posts, comments, member screen, dst.
  profilePhotoUrl     String?
  /// Bio user — short description (max 150 char) yang muncul di header
  /// profile, IG-style. Nullable: user yang belum isi pakai empty text
  /// + placeholder "Tambahkan bio". Dipakai juga di /feed/u/[id] public
  /// profile page (future) dan comment hover di web.
  bio                 String?
  /// Social graph counters. Maintained by the NestJS social service follow
  /// transaction. Kept denormalized so profile reads stay cheap.
  followersCount      Int                  @default(0)
  followingCount      Int                  @default(0)
  orders              Order[]
  points              CustomerPoint[]
  reviews             Review[]
  reviewReplies       ReviewReply[]        @relation("AdminReplies")
  reviewVotes         ReviewVote[]         @relation("ReviewVotes")
  addresses           Address[]
  favorites           Favorite[]
  pets                Pet[]
  cartItems           CartItem[]
  stockNotifications  StockNotification[]
  productViews        UserProductView[]
  voucherUsages       VoucherUsage[]
  announcementReads   AnnouncementRead[]
  // Refund wallet — 1:1 dengan user, lazy-init saat first credit.
  refundWallet        RefundWallet?
  refundLedgers       RefundWalletLedger[]
  refundCases         RefundCase[]
  // Feed relations — admin post & user community video, plus engagement.
  feedPosts           FeedPost[]           @relation("FeedAuthor")
  moderatedFeedPosts  FeedPost[]           @relation("FeedModerator")
  feedComments        FeedComment[]        @relation("FeedCommentAuthor")
  hiddenComments      FeedComment[]        @relation("FeedCommentModerator")
  feedLikes           FeedLike[]
  feedCommentLikes    FeedCommentLike[]
  feedReportsFiled    FeedReport[]         @relation("FeedReporter")
  feedReportsResolved FeedReport[]         @relation("FeedReportResolver")
  feedModerationLogs  FeedModerationLog[]  @relation("FeedModerationActor")
  following           UserFollow[]         @relation("UserFollowing")
  followers           UserFollow[]         @relation("UserFollowers")
  usernameHistory     UsernameHistory[]
  adminActionLogs     AdminActionLog[]
  abuseFlags          AbuseFlag[]          @relation("AbuseFlagTarget")
  reviewedAbuseFlags  AbuseFlag[]          @relation("AbuseFlagReviewer")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

/// Audit log untuk semua admin action critical — refund, order status
/// changes, voucher creation/edit, user actions, dll. Dipakai untuk:
///   1. Compliance / dispute resolution ("siapa yang refund order ini?")
///   2. Detect rogue admin actions (anomaly: 1 admin issue 50 refund
///      dalam 1 jam)
///   3. Onboarding staff baru ("history lama untuk konteks")
///   4. Customer support: "kapan dan kenapa order ini di-cancel?"
///
/// Fire-and-forget — logging failure tidak boleh block admin action.
/// Field `summary` human-readable, `metadata` JSON untuk detail terstruktur.
model AdminActionLog {
  id           String   @id @default(cuid())
  actorUserId  String
  actor        User     @relation(fields: [actorUserId], references: [id])
  /// Action category enum-like string. Convention SCREAMING_SNAKE_CASE.
  /// Examples: ORDER_MARK_PAID, ORDER_CANCELLED, REFUND_ISSUED,
  /// VOUCHER_CREATED, USER_ROLE_CHANGED.
  action       String
  /// Entity type yang di-affect. Examples: Order, RefundCase, Voucher,
  /// User, FeedPost.
  targetType   String
  /// ID record yang di-affect. Pakai untuk join lookup atau filter.
  targetId     String
  /// Short human-readable description untuk display di log feed.
  /// Example: "Issue refund Rp1.626.000 ke order ORD-20260524-M8LKOW"
  summary      String
  /// Optional structured detail JSON. Example untuk refund:
  /// { "amount": 1626000, "reason": "OUT_OF_STOCK", "itemId": "..." }
  metadata     Json?
  /// IP address request untuk audit trail. Nullable kalau request
  /// dari internal worker / cron yang gak punya client IP.
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// History reservasi username — saat user ganti handle, handle lama
/// di-"reserve" 30 hari supaya user lain tidak bisa claim handle yang
/// sama. Anti @mention hijack. Setelah 30 hari, handle release dan
/// boleh diambil siapa aja.
///
/// Lookup uniqueness check di set/change endpoint:
///   - User.username = X → taken (currently owned)
///   - UsernameHistory.username = X AND reservedUntil > NOW() → reserved
model UsernameHistory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Username lama yang di-reserve. Lowercased (sama dengan User.username
  /// di-save lowercase). Bukan unique karena 1 user bisa ganti handle
  /// berkali2 dan tiap ganti bikin row baru. 1 username bisa appear di
  /// 2 row kalau user A pernah pake "asiong", user B pernah pake
  /// "asiong" (setelah reservasi A expired).
  username      String
  /// Tanggal sampai kapan handle ini di-reserve. = changedAt + 30 hari.
  reservedUntil DateTime
  createdAt     DateTime @default(now())

  @@index([username])
  @@index([reservedUntil])
  @@index([userId])
}

/// User-to-user follow graph for the social layer. V1 is public follow only:
/// no private accounts, no request approval, and no brand/shop follow yet.
model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
}

model CartItem {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId             String
  variantId             String?
  variantLabel          String?
  name                  String
  price                 Int
  quantity              Int
  weightGram            Int       @default(500)
  imageUrl              String?
  stock                 Int?
  // Track last abandoned-cart push notification — supaya cron tidak
  // spam user yang sama tiap jam. Set timestamp setelah push terkirim,
  // clear (set null) saat user checkout atau update cart.
  notifiedAbandonedAt   DateTime?
  // Tanda "pertama kali dicurigai abandoned" oleh cron — dipakai untuk
  // syarat 2-putaran-berturut sebelum benar-benar kirim notifikasi.
  // Reset otomatis jadi null setiap kali row ini disinkron ulang (row
  // lama di-delete, row baru dibuat oleh PUT /api/cart replace-total),
  // sehingga tidak perlu invalidasi manual.
  abandonedCandidateAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
  // Index untuk cron query: cari CartItem yang createdAt > 4 jam lalu
  // dan belum di-notify. WHERE notifiedAbandonedAt IS NULL AND createdAt < ...
  @@index([notifiedAbandonedAt, createdAt])
}

/// Notifikasi restock — user subscribe ke produk/variant yang stock=0,
/// dapat FCM saat stock kembali tersedia. Unique constraint per (user,
/// product, variant) supaya tap "Notify me" 2x tidak duplicate row.
/// notifiedAt di-set saat push terkirim, row di-keep untuk audit;
/// re-subscribe = create row baru (lewat upsert) yang reset notifiedAt.
model StockNotification {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  // Saat push terkirim. NULL = pending notification. Setelah notified,
  // row dihapus oleh cron / send helper (sesuai pola lain di codebase).
  notifiedAt DateTime?

  @@unique([userId, productId, variantId])
  @@index([productId, notifiedAt])
  @@index([variantId, notifiedAt])
}

model Category {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  // Consumable detection — produk dengan kategori `isConsumable=true`
  // dianggap habis pakai (mis. makanan, pasir, vitamin). Dipakai oleh
  // recommendation engine untuk:
  //  1. JANGAN exclude produk yang pernah dibeli (user butuh refill).
  //  2. Boost score saat sudah waktunya refill (cycle = typicalRefillDays).
  //  3. Render badge "Saatnya beli ulang" di Flutter card.
  // Kategori durable (kandang, mainan, aksesoris) tetap di-exclude
  // setelah dibeli — user sudah punya, tidak butuh repurchase.
  isConsumable      Boolean   @default(false) @map("is_consumable")
  // Estimasi siklus refill dalam hari. Null kalau bukan consumable.
  // Contoh: makanan 30 hari, pasir 25, snack 14, vitamin 30.
  typicalRefillDays Int?      @map("typical_refill_days")
  products          Product[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true) @map("is_active")
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Hero banner slider di Home (Beranda) app customer. Admin-managed via
/// /admin/banners — ganti gambar, atur urutan, set link tujuan, tanpa
/// redeploy. Menggantikan data/heroSlides.ts yang hardcoded (heroSlides
/// tetap jadi fallback kalau tabel kosong).
///
/// linkType + linkValue = tujuan tap banner (structured, dikonversi ke
/// href di /api/banners untuk konsumsi Flutter):
///   none     → tidak bisa di-tap
///   category → linkValue = slug kategori  → /products?kategori=<slug>
///   product  → linkValue = slug produk    → /products/<slug> (detail)
///   brand    → linkValue = slug brand     → /products?brand=<slug>
///   promo    → /products?diskon=1 (katalog produk diskon)
///   voucher  → /member/vouchers
///   loyalty  → /member/loyalty (tukar poin)
///   url      → linkValue = URL eksternal  → in-app browser
model HomeBanner {
  id        String   @id @default(cuid())
  imageUrl  String
  imageAlt  String   @default("")
  linkType  String   @default("none")
  linkValue String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

/// Popup promo bergambar saat app cold start (gaya Shopee: satu gambar
/// kreatif penuh + tombol X). Admin upload gambar (ideal 1080×1350 / 4:5),
/// app Flutter fetch popup aktif via GET /api/launch-popup.
/// linkType/linkValue = semantik SAMA dengan HomeBanner (lihat komentar di
/// atas). audience: all = semua user, member = hanya user login.
/// startsAt/endsAt opsional — null berarti tanpa batas sisi itu.
model LaunchPopup {
  id        String    @id @default(cuid())
  imageUrl  String
  imageAlt  String    @default("")
  linkType  String    @default("none")
  linkValue String?
  audience  String    @default("member")
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model Product {
  id                    String                      @id @default(cuid())
  name                  String
  slug                  String                      @unique
  // SKU Induk — identifier opsional untuk produk single (tanpa varian)
  // atau sebagai master SKU di parent level. Beda namespace dari
  // ProductVariant.sku yang per-kombinasi varian. Nullable + unique.
  sku                   String?                     @unique
  description           String
  price                 Int
  memberPrice           Int?
  discountPrice         Int?
  // Flash Sale explicit timing — kalau di-set, produk ini WAJIB masuk
  // Flash Sale section di home apapun discount %-nya (admin explicit tag).
  // Kalau null, produk masuk Flash Sale section HANYA kalau discount >=
  // FLASH_SALE_MIN_DISCOUNT_PERCENT (default 20%). Saat flashSaleEndsAt <
  // now, query otomatis exclude produk dari section (auto-cleanup).
  flashSaleEndsAt       DateTime?
  stock                 Int                         @default(0)
  weightGram            Int                         @default(500)
  imageUrl              String?
  // Galeri tambahan (max 4 gambar). imageUrl tetap jadi thumbnail utama,
  // gallery dipakai di halaman detail produk untuk carousel.
  gallery               String[]                    @default([])
  // Video produk (Bunny Stream, library TERPISAH dari feed — lihat
  // lib/product/product-video.ts). Satu video per produk.
  videoUrl              String? // HLS playlist.m3u8 dari CDN Bunny; null = tidak ada
  videoGuid             String? @unique // GUID Bunny — dipakai webhook + GC produk
  videoStatus           String? // "uploading" | "processing" | "ready" | "failed"
  videoThumbnailUrl     String? // auto-thumbnail Bunny, diisi saat ready
  videoDurationSec      Int?
  isActive              Boolean                     @default(true)
  hasVariants           Boolean                     @default(false)
  brandAutoAssigned     Boolean                     @default(false)
  avgRating             Float                       @default(0)
  reviewCount           Int                         @default(0)
  ratingBreakdown       Json?
  // Denormalized search text (name + brand + variant names + sku codes).
  // Di-maintain oleh app code (lib/search.ts syncProduct) + script backfill.
  // GIN trigram index ada di migration product_search_text_trgm.
  searchText            String                      @default("") @map("searchText")
  categoryId            String?
  category              Category?                   @relation(fields: [categoryId], references: [id])
  brandId               String?
  brand                 Brand?                      @relation(fields: [brandId], references: [id])
  orderItems            OrderItem[]
  reviews               Review[]
  variants              ProductVariant[]
  variantAttrs          VariantAttribute[]
  favorites             Favorite[]
  stockNotifications    StockNotification[]
  viewedBy              UserProductView[]
  // Promo Toko campaign items yang ikut produk ini.
  discountItems         ProductDiscountItem[]
  recommendationSources ProductRecommendationRule[] @relation("RecommendationSource")
  recommendationTargets ProductRecommendationRule[] @relation("RecommendationTarget")
  // Feed posts yang tag/link ke produk ini (admin product card, promo, video+product).
  feedPosts             FeedPost[]
  // Shop the Look back-relation — semua feed post (multi-tag) yang
  // pakai produk ini, untuk product page "Postingan Pelanggan" tab.
  feedPostTags          FeedPostProduct[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  // Kapan admin terakhir MENGEDIT produk ini (via form Edit Produk) atau
  // membuatnya. Beda dari updatedAt yang ikut berubah otomatis tiap stok
  // turun / rating / promo. Dipakai admin list untuk urutkan "baru diedit"
  // ke atas + badge. Nullable; produk lama (pre-kolom) = null → jatuh ke
  // createdAt saat sort.
  lastEditedAt          DateTime?
}

model UserProductView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @map("viewed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@index([productId])
  @@map("user_product_views")
}

model ProductRecommendationRule {
  id                   String   @id @default(cuid())
  sourceProductId      String   @map("source_product_id")
  sourceProduct        Product  @relation("RecommendationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  recommendedProductId String   @map("recommended_product_id")
  recommendedProduct   Product  @relation("RecommendationTarget", fields: [recommendedProductId], references: [id], onDelete: Cascade)
  relationType         String   @default("complementary") @map("relation_type")
  priority             Int      @default(0)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([sourceProductId, recommendedProductId, relationType])
  @@index([sourceProductId, isActive, priority])
  @@index([recommendedProductId])
  @@map("product_recommendation_rules")
}

model Order {
  id                      String          @id @default(cuid())
  orderNumber             String          @unique
  userId                  String?
  user                    User?           @relation(fields: [userId], references: [id])
  customerName            String
  customerPhone           String
  customerEmail           String?
  shippingAddress         String
  shippingCity            String?
  shippingPostalCode      String?
  shippingLatitude        Float?
  shippingLongitude       Float?
  shippingPinpointAddress String?
  shippingAreaId          String?
  shippingAreaLabel       String?
  shippingProvinceName    String?
  shippingDistrictName    String?
  orderType               String          @default("DELIVERY")
  shippingMethod          String          @default("DELIVERY")
  courierCode             String?
  courierService          String?
  trackingNumber          String?
  // Info driver untuk kurir INSTANT (Gojek/Grab/Lalamove/Borzo) yang
  // tidak punya resi tradisional. Format bebas — biasanya admin isi
  // "Nama: ... | HP: ... | Plat: ..." atau link share GPS dari aplikasi
  // kurir. Lihat markAsShipped validation: salah satu dari trackingNumber
  // atau shippingDriverInfo wajib diisi saat tandai SHIPPED.
  shippingDriverInfo      String?
  trackingToken           String?         @unique
  biteshipOrderId         String?
  biteshipTrackingUrl     String?
  shipmentStatus          String?
  biteshipRequest         Json?
  biteshipResponse        Json?
  biteshipError           String?
  pickupStoreName         String?
  pickupStoreAddress      String?
  pickupStoreLatitude     Float?
  pickupStoreLongitude    Float?
  pickupHours             String?
  pickupCode              String?         @unique
  pickupQrCode            String?
  pickupStatus            String?
  readyForPickupAt        DateTime?
  pickedUpAt              DateTime?
  pickedUpByAdminId       String?
  subtotal                Int
  shippingCost            Int             @default(0)
  discount                Int             @default(0)
  total                   Int
  status                  OrderStatus     @default(PENDING)
  paymentProvider         PaymentProvider @default(MANUAL)
  paymentStatus           PaymentStatus   @default(UNPAID)
  paymentReference        String?
  paymentUrl              String?
  paymentProofUrl         String?
  manualBank              String?
  uniqueCode              Int?
  voucherCode             String? // Customer voucher (CUSTOMER source type)
  manualVoucherCode       String? // Seller manual voucher (SELLER_MANUAL)
  freeShippingVoucherCode String?
  shippingVoucherCode     String? // Generic shipping voucher slot (from migration 20260518010000)
  productVoucherCode      String?
  loyaltyVoucherCode      String?
  privateVoucherCode      String?
  productDiscount         Int             @default(0)
  shippingDiscount        Int             @default(0)
  // Saldo refund yang user pakai untuk bayar order ini. Dikurangkan
  // setelah subtotal + ongkir - diskon (lihat spec rumus). Saat order
  // di-create, di-debit dari RefundWallet via helper atomic + ledger.
  refundBalanceUsed       Int             @default(0)
  notes                   String?

  // Timestamp saat admin tandai SHIPPED (markAsShipped action). Dipakai
  // oleh cron /api/cron/auto-confirm-delivered untuk auto-mark DELIVERED
  // setelah 7 hari kalau user belum konfirmasi terima sendiri. Tidak
  // pakai updatedAt karena field itu kena trigger update setiap kali
  // order touched (cancellation request, refund case, dll) → cron bisa
  // gak pernah jalan.
  shippedAt               DateTime?
  // Timestamp saat user di-kirim H-3 reminder push "Sudah Diterima?".
  // Cron /api/cron/order-confirm-reminder set field ini supaya tidak
  // kirim ulang reminder yang sama. Null = belum pernah di-remind.
  notifiedConfirmReminderAt DateTime?

  // ── Cancellation request (Shopee/Tokopedia pattern) ──────────────────
  // Saat user pencet "Batalkan" di app setelah order udah PAID
  // (paymentStatus === "PAID"), order TIDAK langsung berubah ke CANCELLED.
  // Sebagai gantinya, request di-record di field-field ini, lalu admin
  // bisa Approve (run markAsCancelled flow yang sama) atau Reject.
  //
  // Kalau paymentStatus belum PAID, user cancel langsung di-accept tanpa
  // mengisi field-field ini (instant cancel).
  //
  // Kenapa pakai field bukan tabel terpisah: 1 order paling banyak 1
  // pending request aktif. Kalau admin reject, field tetep terisi
  // (status=REJECTED) supaya user lihat reject reason; kalau user submit
  // ulang, field di-overwrite. Bisa di-migrate ke OrderCancellationRequest
  // model nanti kalau butuh history multi-attempt.
  cancellationRequestStatus     String?   // null | "PENDING" | "APPROVED" | "REJECTED"
  cancellationReason            String?   // alasan dari user (opsional)
  cancellationRequestedAt       DateTime?
  cancellationRespondedAt       DateTime?
  cancellationRespondedByAdminId String?
  cancellationRejectReason      String?   // diisi kalau admin tolak

  items                   OrderItem[]
  voucherUsages           VoucherUsage[]
  refundCases             RefundCase[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([biteshipOrderId])
  @@index([shipmentStatus])
  @@index([orderType])
  @@index([pickupStatus])
  // Admin filter "Pending Cancellation Requests" — fast lookup tanpa
  // full table scan. Cardinality kecil (most orders punya null).
  @@index([cancellationRequestStatus])
  // Composite index untuk cron auto-confirm-delivered query:
  // WHERE status='SHIPPED' AND shippedAt < threshold. Status pertama
  // karena selectivity tinggi (hanya beberapa order yang SHIPPED).
  @@index([status, shippedAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  variantLabel String? // snapshot: "4KG / Beef" — tidak berubah meski variant diedit
  name         String
  price        Int
  quantity     Int
  weightGram   Int             @default(500)
  reviews      Review[] // multiple kalau user soft-delete & resubmit
  refundCases  RefundCase[]
}

// Promo Toko campaign metadata — ala Shopee Seller. Diskon per-produk
// dengan periode terjadwal (1-90 hari). Tiap produk dalam promo bisa
// punya HARGA DISKON BERBEDA via ProductDiscountItem.
//
// Refactor dari single-row pattern lama: dulu ProductDiscount punya
// discountType + discountValue + productIds[] → semua produk dapat
// diskon sama. Sekarang split: ProductDiscount = metadata only,
// ProductDiscountItem = per-produk/varian config.
model ProductDiscount {
  id        String                @id @default(cuid())
  // Internal name untuk admin (mis. "Promo Hari Pet Nasional").
  // TIDAK ditampilkan ke customer.
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean               @default(true)
  items     ProductDiscountItem[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([startsAt, endsAt])
  @@index([isActive])
}

// Per-product (atau per-variant) discount config dalam satu promo.
// 1 row = 1 produk/variant yang ikut promo dengan harga diskon
// dan toggle aktif sendiri.
//
// Untuk produk tanpa varian: variantId = null, 1 row per product.
// Untuk produk berVarian: 1 row per variant (variantId set).
model ProductDiscountItem {
  id              String          @id @default(cuid())
  discountId      String
  discount        ProductDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // Harga FINAL setelah diskon (Rp). Source of truth untuk customer-
  // side price display — TIDAK perlu compute dari %, sudah hardcoded.
  discountedPrice Int
  // Toggle aktif per-item. Admin bisa pause specific produk/variant
  // tanpa hapus dari promo (mis. stok habis sementara).
  isItemActive    Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Index untuk query "active discount untuk produk X / varian Y"
  // (dipakai Phase 1D customer-side price calculator).
  @@index([productId, variantId])
}

// Voucher categorization enums — match migration files:
// 20260518000000_add_voucher_kind, 20260518020000_add_new_member_voucher_rules,
// 20260518030000_add_voucher_usage_limit_period.
enum VoucherKind {
  PRODUCT_DISCOUNT
  FREE_SHIPPING
  LOYALTY_CLAIM
  MANUAL_PRIVATE
}

enum VoucherTargetUser {
  ALL_MEMBERS
  NEW_MEMBER
}

enum VoucherUserUsageLimitPeriod {
  NONE
  LIFETIME
  DAY
  WEEK
  MONTH
}

model Voucher {
  id                                String                      @id @default(cuid())
  name                              String?
  code                              String                      @unique
  description                       String?
  discountPercent                   Int?
  discountAmount                    Int?
  maxDiscountAmount                 Int?
  minimumOrder                      Int                         @default(0)
  maxUsage                          Int?
  usedCount                         Int                         @default(0)
  usageLimitPerUser                 Int                         @default(1)
  usageLimitPeriod                  VoucherUserUsageLimitPeriod @default(LIFETIME)
  startsAt                          DateTime                    @default(now())
  expiresAt                         DateTime?
  isActive                          Boolean                     @default(true)
  // Voucher milik user spesifik (BDAY, POIN claim). NULL = voucher publik (admin promo).
  userId                            String?
  // Source type: CUSTOMER (visible di daftar pembeli) vs SELLER_MANUAL
  // (tersembunyi, hanya via input kode manual). Default CUSTOMER untuk
  // backward compat semua voucher existing.
  sourceType                        VoucherSourceType           @default(CUSTOMER)
  type                              VoucherType                 @default(PUBLIC_PRODUCT_DISCOUNT)
  kind                              VoucherKind                 @default(PRODUCT_DISCOUNT)
  visibility                        VoucherVisibility           @default(PUBLIC)
  discountType                      VoucherDiscountType         @default(FIXED_AMOUNT)
  discountScope                     VoucherDiscountScope        @default(PRODUCT)
  targetUser                        VoucherTargetUser           @default(ALL_MEMBERS)
  newMemberMaxAccountAgeDays        Int?
  newMemberRequireNoSuccessfulOrder Boolean                     @default(false)
  eligibleUserIds                   String[]                    @default([])
  eligibleProductIds                String[]                    @default([])
  eligibleCategoryIds               String[]                    @default([])
  // Target brand — dipilih via picker admin (bukan ketik manual). Cocok
  // ke Product.brandId. Sama aturan kosong=berlaku-semua seperti
  // eligibleProductIds/eligibleCategoryIds (lihat voucherMatchesProduct
  // di lib/voucher-eligibility.ts).
  eligibleBrandIds                  String[]                    @default([])
  usages                            VoucherUsage[]
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt

  @@index([userId])
  @@index([type, visibility])
  @@index([discountScope])
}

model VoucherUsage {
  id             String   @id @default(cuid())
  voucherId      String
  voucher        Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Int      @default(0)
  voucherType    String
  usedAt         DateTime @default(now())

  @@unique([voucherId, orderId])
  @@index([voucherId])
  @@index([userId])
  @@index([orderId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  createdAt DateTime @default(now())
}

model CustomerPoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  source    String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime? // null = belum dipakai
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RegistrationOtp {
  id           String    @id @default(cuid())
  name         String
  /// Public handle dipilih user di register flow — wajib untuk user
  /// baru (mandatory di sign-up). Disimpan disini supaya pas step-2
  /// (verify OTP) langsung di-set ke User.username dalam transaction
  /// yang sama. Validasi format + uniqueness done di register endpoint
  /// sebelum row ini di-create. Nullable untuk backward-compat row
  /// lama yang dibuat sebelum fitur username live.
  username     String?
  email        String
  phone        String
  passwordHash String
  channel      String
  otpHash      String
  expiresAt    DateTime
  attempts     Int       @default(0)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

/// OTP untuk login passwordless via WhatsApp.
/// Berbeda dari RegistrationOtp: user sudah terdaftar di tabel User,
/// jadi tidak perlu simpan passwordHash. Foreign key `userId` di-resolve
/// di endpoint request (lookup User by phone) — disimpan di sini supaya
/// verify cukup compare otpHash + lookup user by id, anti enumeration.
model LoginOtp {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([phone])
  @@index([expiresAt])
}

enum ReviewStatus {
  VISIBLE
  HIDDEN // di-hide oleh admin
  DELETED // soft-delete oleh user (boleh resubmit)
}

model Review {
