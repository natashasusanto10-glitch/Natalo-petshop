<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ============================================================
         Permissions — match dengan iOS Info.plist usage descriptions.
         Plugin Flutter ingest pemissions berikut secara otomatis,
         tapi tetap declare di sini supaya manifest jelas + audit-able.
         ============================================================ -->
    <!-- HTTP fetch ke Next.js backend. WAJIB. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Kamera — review produk + Feed video record + barcode scanner. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Mikrofon — audio saat record video Feed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Galeri foto/video — image_picker. Android 13+ pakai READ_MEDIA_* per type. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <!-- Legacy untuk Android 12 dan bawah. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <!-- GPS — auto-fill alamat dengan "Pakai Lokasi Saya". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Push notification — Android 13+ butuh runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Biometric — local_auth plugin. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <!-- Vibrator — haptic_feedback plugin. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:label="Natalo Petshop"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link handler — terima URI natalopetshop.com/* dari
                 browser/share intent → app_links plugin route ke screen
                 yang sesuai via DeepLinkService.handleExternalUri. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="natalopetshop.com"/>
                <data android:scheme="https" android:host="www.natalopetshop.com"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <!-- Package visibility (Android 11+): app perlu declare paket/intent
         yang dia query supaya canLaunchUrl/launchUrl bekerja. Tanpa block
         ini, launchUrl(wa.me/...) di Android 11+ akan fallback ke browser
         (sama issue iOS tanpa LSApplicationQueriesSchemes).
         Match iOS: Info.plist LSApplicationQueriesSchemes [https, http,
         mailto, tel, whatsapp]. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher web links (https / http). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- mailto + tel — kalau Anda nanti tambah email/phone tap. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- WhatsApp deep link langsung ke app (kalau install). Tanpa ini
             wa.me/... fallback ke Chrome/Safari. -->
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
    </queries>
</manifest>
