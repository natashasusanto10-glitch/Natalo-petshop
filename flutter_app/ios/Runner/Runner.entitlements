<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push notifications via firebase_messaging — entitlement aps-environment
	  WAJIB sebelum app bisa terima APNs token. Value:
	  - "development": untuk Debug build (TestFlight + simulator pakai dev APNs)
	  - "production": untuk Release / App Store distribution (production APNs)
	  Xcode auto-pilih sesuai build config kalau pakai $(APS_ENVIRONMENT)
	  variable, tapi explicit string lebih portable. Pakai "production" karena
	  TestFlight + App Store distribution semua pakai production APNs.

	  App ID `com.natalo.petshop` di Apple Developer Portal sudah enable
	  Push Notifications capability — match dengan entitlement ini.
	-->
	<key>aps-environment</key>
	<string>production</string>

	<!--
	  Associated Domains untuk iOS Universal Links.
	  Mirror Android intent-filter di AndroidManifest.xml.

	  iOS akan fetch https://natalopetshop.com/.well-known/apple-app-site-association
	  saat app pertama install / saat OS verify. File AASA harus serve dengan:
	    - Content-Type: application/json
	    - HTTPS (no redirect)
	    - JSON body sesuai format Apple

	  Endpoint AASA sudah ada di Next.js project:
	  app/.well-known/apple-app-site-association/route.ts
	  Pastikan appID di file itu = TeamID.com.natalo.petshop (sesuaikan setelah
	  Apple Developer Team ID confirmed).

	  Mode `applinks:` = production. `applinks:?mode=developer` untuk testing
	  via QR code/skip caching (debug build only).
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:natalopetshop.com</string>
		<string>applinks:www.natalopetshop.com</string>
	</array>
</dict>
</plist>
