<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Natalo Petshop</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>natalo_petshop_flutter</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- Skip export compliance prompt di TestFlight — app tidak pakai
	     enkripsi proprietary, cuma HTTPS standard. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Permission usage descriptions — wajib untuk plugin native iOS.
	     Tanpa keys ini, app akan crash saat akses Camera/Photos/Mic/dll.
	     Apple mandates. Pesan harus dalam bahasa yang user pahami. -->
		<key>NSCameraUsageDescription</key>
		<string>Natalo Petshop butuh akses kamera untuk kamu ambil foto saat menulis review produk dan merekam video untuk Feed.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Natalo Petshop butuh akses mikrofon untuk merekam audio saat kamu membuat video Feed dari kamera.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Natalo Petshop butuh akses galeri foto untuk kamu pilih foto saat menulis review produk dan video saat membuat postingan Feed.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Natalo Petshop butuh izin menyimpan foto ke galeri kamu (untuk save bukti tracking, dll).</string>
		<!-- Voice search di product list — speech_to_text plugin pakai
	     SFSpeechRecognizer (Apple) yang butuh speech permission. -->
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Natalo Petshop pakai pencarian suara untuk kamu cari produk dengan bicara, lebih cepat dari mengetik.</string>
		<!-- GPS lokasi — auto-fill alamat dengan "Pakai Lokasi Saya" di address
	     form. Geolocator plugin butuh "WhenInUse" untuk foreground only. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Natalo Petshop butuh akses lokasi untuk auto-fill alamat pengiriman dan menampilkan toko terdekat.</string>
		<!-- Biometric auth (Face ID) — local_auth plugin pakai LocalAuthentication
	     framework yang butuh usage description di iOS 11+. -->
		<key>NSFaceIDUsageDescription</key>
		<string>Login ke akun Natalo Petshop kamu dengan Face ID — lebih cepat dan aman.</string>
		<!-- Push notifications via firebase_messaging + flutter_local_notifications.
		     Background mode "remote-notification" supaya APNs payload bisa
		     wake app untuk fetch content (FCM). Plus "fetch" untuk
		     background fetch berkala. Tanpa ini, push notif tidak akan
		     trigger app handler saat app di-background. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIStatusBarStyle</key>
		<string>UIStatusBarStyleLightContent</string>
		<!-- LSApplicationQueriesSchemes — diperlukan iOS 9+ untuk
		     `canOpenURL` + `launchUrl` ke external app schemes. Tanpa
		     ini, launchUrl(LaunchMode.externalApplication) untuk wa.me/...
		     akan fallback ke Safari, BUKAN buka WhatsApp app. Apple
		     mandates declare scheme yang app pakai. -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>https</string>
			<string>http</string>
			<string>mailto</string>
			<string>tel</string>
			<string>whatsapp</string>
		</array>
	</dict>
</plist>
