# Platform WAJIB eksplisit. Tanpa baris ini CocoaPods menebak sendiri dan
# memperingatkan "Automatically assigning platform iOS with version 13.0"
# untuk tiap target — tebakan itu tidak selalu cocok dengan yang diminta
# pod, dan errornya muncul sebagai "could not find compatible versions for
# pod Flutter" yang menyesatkan.
#
# WAJIB sama dengan IPHONEOS_DEPLOYMENT_TARGET di Runner.xcodeproj (keenam
# konfigurasi). Kalau salah satu diubah, ubah keduanya.
#
# Dinaikkan 13.0 -> 15.0 bersama upgrade Flutter 3.47.1, yang pod-nya
# menuntut iOS 15.0. Apple juga mewajibkan MinimumOSVersion 15.0 untuk
# semua app mulai Spring 2027 (warning 90068 di log unggah), jadi ini
# arah yang sama, bukan pengorbanan sia-sia.
#
# KONSEKUENSI: pengguna iOS 13 & 14 tidak bisa lagi memasang pembaruan.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Notification Service Extension — WAJIB dapat FirebaseMessaging sendiri
# (target Xcode terpisah, tidak otomatis warisi pod dari Runner). Dipakai
# NotificationService.swift (FIRMessagingExtensionHelper) supaya rich
# image (imageUrl) dari push benar-benar diunduh & ditempel di notifikasi
# iOS — lihat flutter_app/ios/NotificationService/.
target 'NotificationService' do
  use_frameworks!
  # VERSI WAJIB DIPATOK, dan wajib SAMA dengan yang dipakai plugin Flutter.
  # Sumber kebenaran: firebase_core/ios/firebase_sdk_version.rb di pub cache
  # (firebase_core 3.15.2 -> 11.15.0). Plugin firebase_messaging memakai
  # angka yang sama lewat berkas itu.
  #
  # Tanpa patokan, CocoaPods menarik FirebaseMessaging TERBARU yang
  # mensyaratkan iOS 15+, sementara app menargetkan iOS 13 — `pod install`
  # gagal dengan pesan menyesatkan "could not find compatible versions for
  # pod Flutter", seolah Flutter yang bermasalah. Selain itu ekstensi dan
  # Runner bisa menarik dua versi Firebase berbeda dalam satu app.
  #
  # SAAT UPGRADE firebase_core/firebase_messaging: baca ulang
  # firebase_sdk_version.rb dan samakan angka di bawah ini.
  pod 'FirebaseMessaging', '11.15.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
