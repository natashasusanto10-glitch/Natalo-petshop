# Auth
SESSION_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
ADMIN_EMAIL="admin@toko.com"
ADMIN_PASSWORD="ganti-password-admin-kamu"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toko_pwa?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/toko_pwa?schema=public"

# Social Service (NestJS)
# Pakai DATABASE_URL, DIRECT_URL, dan SESSION_SECRET yang sama dengan Next.js.
SOCIAL_SERVICE_PORT="4001"

# Public app config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Natalo Petshop & Aquarium Official Store"
NEXT_PUBLIC_WHATSAPP_NUMBER="+6281289997113"
NEXT_PUBLIC_STORE_ADDRESS="Jl. Contoh No.1, Kota, Provinsi"

# Payment
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# Shipping: choose one for v1
BITESHIP_API_KEY=""
RAJAONGKIR_API_KEY=""
SHOP_ORIGIN_CONTACT_NAME="Natalo Petshop"
SHOP_ORIGIN_CONTACT_PHONE=""
SHOP_ORIGIN_ADDRESS="Jl. Contoh No.1, Kota, Provinsi"
SHOP_ORIGIN_NOTE=""
SHOP_ORIGIN_LATITUDE=""
SHOP_ORIGIN_LONGITUDE=""
SHOP_ORIGIN_POSTAL_CODE=""
SHOP_ORIGIN_AREA_ID=""
WAREHOUSE_AREA_ID=""

# Push Notifications (Web Push / VAPID)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Push Notifications (FCM / Android native via Capacitor)
# Dari Firebase Console → Project Settings → Service accounts → Generate new private key (JSON).
# PRIVATE_KEY isinya multi-line PEM — di Vercel, ganti newline ke literal "\n".
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# ---- Customer Chat (project tokochat-a8879) ----
# Service account TERPISAH dari FCM natalopetshop. Jangan campur kredensial.
TOKOCHAT_PROJECT_ID=""
TOKOCHAT_CLIENT_EMAIL=""
TOKOCHAT_PRIVATE_KEY=""
# Shared secret HMAC untuk webhook Cloud Function tokochat -> proxy Natalo.
CHAT_WEBHOOK_SECRET=""

# UploadThing — file uploads (foto produk, review, bukti transfer)
# Get token: https://uploadthing.com → dashboard → API Keys
UPLOADTHING_TOKEN=""

# Bunny Stream — customer feed video encoding + HLS playback
# Get from bunny.net → Stream → your Video Library
#   Library ID:    numeric, from library detail page URL
#   API Key:       Library Settings → API
#   CDN Hostname:  Library Settings → Embed (format: vz-xxxxx.b-cdn.net)
#   Webhook Secret (optional): Library Settings → Webhook (we verify
#                              Authorization: Bearer <secret> on callbacks)
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
BUNNY_CDN_HOSTNAME=""
BUNNY_WEBHOOK_SECRET=""

# Video Produk — Bunny Stream LIBRARY TERPISAH dari feed (BUNNY_LIBRARY_ID)
# Get dari bunny.net → Stream → dedicated Video Library untuk product videos
#   Library ID:    numeric, dari library detail page URL
#   API Key:       Library Settings → API
#   CDN Hostname:  Library Settings → Embed (format: vz-xxxxx.b-cdn.net)
#   Webhook Secret (optional): Library Settings → Webhook untuk video ready/error callbacks
BUNNY_PRODUCT_LIBRARY_ID=""
BUNNY_PRODUCT_API_KEY=""
BUNNY_PRODUCT_CDN_HOSTNAME=""
BUNNY_PRODUCT_WEBHOOK_SECRET=""

# AI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"

# WhatsApp Gateway — Fonnte (https://fonnte.com)
# Scope: HANYA untuk OTP register member + OTP login member.
# Notifikasi order (dibuat, dibayar, dikirim, dst.) sudah TIDAK lewat WA —
# gunakan email + push notification saja.
# Token device → dashboard Fonnte → Device → API → Token (20 char alphanumeric).
FONNTE_TOKEN=""
# Optional override — default https://api.fonnte.com/send
FONNTE_ENDPOINT=""
# Anti-spam knobs (default sudah sane, override hanya kalau perlu):
# WA_MIN_SEND_INTERVAL_MS="1200"    # delay antar pesan supaya tidak banned
# WA_DEDUPE_WINDOW_MS="120000"      # 2 menit — skip pesan identik
# WA_MAX_RETRIES="3"
# WA_RETRY_DELAY_MS="300000"        # 5 menit

# AI features
# ANTHROPIC_API_KEY — pakai Claude untuk AI voucher creation di
# /admin/vouchers/new "Buat dengan AI" button. Optional — kalau gak
# di-set, button tampil tapi click return error 500 "MISSING_KEY".
# Dapat key dari https://console.anthropic.com/settings/keys
# Set di Vercel: Settings → Environment Variables → Production
ANTHROPIC_API_KEY=""

# ─── Sentry (Error Tracking) ─────────────────────────────────────────
# Bikin project di https://sentry.io → pilih platform "Next.js" →
# copy DSN. Set keduanya di Vercel (Production + Preview).
#
# SENTRY_DSN     — server-side capture (API routes, server components)
# NEXT_PUBLIC_SENTRY_DSN — client-side capture (browser, PWA)
# Biasanya isinya sama. Pisah supaya bisa scope quota beda kalau perlu.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Source map upload (optional, untuk decode minified stack trace di Sentry UI):
# - Buat auth token di https://sentry.io/settings/account/api/auth-tokens/
#   scope: project:releases + project:write
# - SENTRY_ORG = slug org Sentry (mis. "natalo-petshop")
# - SENTRY_PROJECT = slug project Sentry (mis. "natalo-web")
# Tanpa SENTRY_AUTH_TOKEN, error tetap masuk tapi stack trace minified.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
